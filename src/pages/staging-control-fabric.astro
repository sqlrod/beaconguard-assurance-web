---
/**
 * Staging-only Pass 01B-R3A2 — Orthographic closed-loop circuit reconstruction.
 * noindex, nofollow, excluded from sitemap, not linked from nav/footer.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ControlFabricHero from "../components/diagrams/ControlFabricHero.astro";
---

<BaseLayout
  title="Staging · Control Fabric R3A2 | BeaconGuard"
  description="Staging-only Pass 01B-R3A2 orthographic closed-loop circuit reconstruction."
  noindex={true}
>
  <section class="staging-banner" role="note">
    <strong>STAGING ONLY · PASS 01B-R3A2</strong>
    <p>
      Orthographic closed-loop circuit reconstruction. George-supplied code was
      not copied. noindex, excluded from sitemap, not linked from navigation or
      footer. Public homepage unchanged. Pass 01C remains unauthorized.
    </p>
  </section>

  <section class="stack-section">
    <h1>Orthographic closed-loop circuit reconstruction</h1>
    <p class="lead">
      Rebuilt from first principles: persistent Enterprise Application, aperture
      authorization gates, DENY barrier terminals outside the circuit, ALLOW
      return into Execute, then application execution to System of Record.
    </p>
    <p><code>IMPLEMENTATION_COMPLETE_PENDING_INDEPENDENT_VISUAL_REVIEW</code></p>
  </section>

  <section class="stack-section" id="r3a1-rejected">
    <h2>1. R3A1 rejected reference</h2>
    <ul class="staging-cf-defects">
      <li>Decision content still overlaps or crowds the transaction</li>
      <li>DENY outcomes too close to authorization gates</li>
      <li>Decision labels compete with normal transaction labels</li>
      <li>Lacks evenly distributed negative space</li>
      <li>Enterprise Application not sufficiently dominant as one persistent participant</li>
      <li>ALLOW must visibly return to Execute; execution must continue to SoR</li>
      <li>DENY must be barrier terminals, not rectangular decision boxes</li>
    </ul>
    <figure class="staging-cf-panel">
      <img
        src="/staging-review/r3a1-control-fabric-rejected-1440.png"
        alt="Rejected R3A1 Control Fabric desktop crop"
        width="1100"
        height="620"
        loading="lazy"
      />
      <figcaption>
        Rejected R3A1 reference (also in
        <code>review-artifacts/pass-01b-r3a1-control-fabric-geometry-correction/crops/</code>).
      </figcaption>
    </figure>
  </section>

  <section class="stack-section" id="r3a2-desktop" data-crop="control-fabric">
    <h2>2. R3A2 desktop candidate</h2>
    <p>Independent-review status: <strong>PENDING</strong></p>
    <div class="staging-cf-canvas">
      <ControlFabricHero idPrefix="cf-r3a2" forceDesktop={true} title="Control Fabric — R3A2 desktop" />
    </div>
  </section>

  <section class="stack-section" id="r3a2-hero-size" data-crop="control-fabric-hero-size">
    <h2>3. Candidate at homepage visual-column size</h2>
    <div class="staging-cf-hero-slot">
      <ControlFabricHero idPrefix="cf-r3a2-slot" forceDesktop={true} title="Control Fabric — hero column" />
    </div>
  </section>

  <section class="stack-section" id="r3a2-compact" data-crop="control-fabric-mobile">
    <h2>4. R3A2 compact candidate</h2>
    <div class="staging-cf-mobile">
      <ControlFabricHero idPrefix="cf-r3a2-m" compact={true} title="Control Fabric — compact" />
    </div>
  </section>

  <section class="stack-section" id="geometry">
    <h2>5. Geometry measurements</h2>
    <ul class="staging-cf-checklist">
      <li>Desktop viewBox: <code>0 0 1200 760</code></li>
      <li>Enterprise Application: x40 y64 · 300×600 · states 236×88 at y 120 / 320 / 520</li>
      <li>Gates: x440 · 250×104 · Admission y112 · Result-to-Action y336</li>
      <li>AI Provider: x840 y112 · 300×144 (muted untrusted boundary)</li>
      <li>System of Record: x840 y520 · 300×104</li>
      <li>REQUEST DENY barrier pocket: ≈ x510–620 / y32–88</li>
      <li>ACTION DENY barrier pocket: ≈ x510–620 / y456–512</li>
      <li>Return lane y≈284 · ALLOW return lane y≈564 · Evidence y≈672–728</li>
      <li>Compact viewBox: <code>0 0 440 1140</code></li>
    </ul>
  </section>

  <section class="stack-section" id="status">
    <h2>6. Independent-review status</h2>
    <p><strong>PENDING</strong> — do not self-issue visual acceptance. Pass 01C unauthorized.</p>
  </section>
</BaseLayout>
