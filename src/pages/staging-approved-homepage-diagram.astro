---
/**
 * Staging-only — approved homepage diagram integration review.
 * noindex, nofollow, excluded from sitemap, not linked from nav/footer.
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const sourceSha = "1F3B5EC10431787D1D51C65AF88B94AF82838E7E0C1746F1FA7EFB1932616371";
const publicSha = sourceSha;
const width = 1672;
const height = 941;
---

<BaseLayout
  title="Staging · Approved homepage diagram | BeaconGuard"
  description="Staging-only review of the approved governed-transaction diagram on the homepage hero."
  noindex={true}
>
  <section class="staging-banner" role="note">
    <strong>STAGING ONLY · APPROVED DIAGRAM HOMEPAGE INTEGRATION</strong>
    <p>
      Static approved diagram placed in the homepage hero. Image contents were not
      modified. noindex, excluded from sitemap, not linked from navigation or
      footer. Pass 01C remains unauthorized.
    </p>
  </section>

  <section class="stack-section">
    <h1>Approved homepage diagram integration</h1>
    <p class="lead">
      Staging review of the approved governed-transaction image in the homepage
      hero layout. Diagram source was copied exactly into the public asset path.
    </p>
    <p><code>PENDING INDEPENDENT HOMEPAGE REVIEW</code></p>
  </section>

  <section class="stack-section" id="source">
    <h2>1. Approved source image</h2>
    <p>
      Public path: <code>/images/diagrams/beaconguard-governed-transaction.png</code>
      · Intrinsic size: {width} × {height}
    </p>
    <p>
      SHA-256 (source = public): <code>{publicSha}</code>
    </p>
    <figure class="staging-cf-panel">
      <img
        class="hero-approved-diagram-source"
        src="/images/diagrams/beaconguard-governed-transaction.png"
        alt="Approved BeaconGuard governed transaction diagram at intrinsic aspect ratio"
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="stack-section" id="in-hero" data-crop="approved-in-hero">
    <h2>2. Approved image inside homepage hero layout</h2>
    <section class="hero-split hero-split--home staging-approved-hero">
      <div class="hero-split-copy">
        <p class="hero-eyebrow">INDEPENDENT AI ACTION AUTHORIZATION</p>
        <h2 class="staging-cf-hero-title">
          <span class="hero-line">Control before execution.</span>
          <span class="hero-line">Evidence after every decision.</span>
        </h2>
        <p class="hero-subheadline">
          BeaconGuard governs whether an enterprise application may invoke AI and
          whether a declared action based on the returned result may affect an
          enterprise system.
        </p>
        <div class="page-actions page-actions--hero page-actions--hero-split">
          <span class="btn-primary" aria-disabled="true">Request Controlled Evaluation</span>
          <span class="btn-secondary" aria-disabled="true">See How It Works</span>
          <span class="text-link" aria-disabled="true">Explore Verification</span>
        </div>
      </div>
      <div class="hero-split-visual">
        <figure class="hero-approved-diagram">
          <img
            src="/images/diagrams/beaconguard-governed-transaction.png"
            alt="BeaconGuard governed AI transaction architecture in homepage hero layout."
            width={width}
            height={height}
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>
  </section>

  <section class="stack-section">
    <h2>3. Presentation notes</h2>
    <ul class="staging-cf-checklist">
      <li>Desktop: copy left (~44–48%), diagram right (~52–56%), headline two lines at 1440.</li>
      <li>Mobile: stacked copy above diagram; object-fit contain; no crop; no list fallback.</li>
      <li>Image not modified; binary copy only into the public diagrams path.</li>
      <li>Root upload filename is not committed; only the normalized public asset is staged.</li>
      <li>Independent-review status: <strong>PENDING</strong></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .hero-approved-diagram-source {
    display: block;
    width: 100%;
    max-width: 1100px;
    height: auto;
  }
  .staging-approved-hero .btn-primary,
  .staging-approved-hero .btn-secondary,
  .staging-approved-hero .text-link {
    pointer-events: none;
    opacity: 0.9;
  }
</style>
