      color: var(--hero-accent);
      font-size: 1.18rem;
      line-height: 1.55;
    }

    .article-featured {
      max-width: 1050px;
      margin: 2.2rem auto 0;
    }

    .article-featured img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 0.5rem;
      border: 1px solid rgba(148, 163, 184, 0.3);
      background: #f7fbff;
      object-fit: contain;
    }

    /* =========================
       LIGHT EDITORIAL READING SURFACE
       Full-bleed band scoped to the Insights article body only.
       ========================= */
    .insight-reading-surface {
      --read-bg: #f6f8fb;
      --read-bg-panel: #ffffff;
      --read-heading: #0b1b2e;
      --read-body: #334155;
      --read-muted: #64748b;
      --read-border: rgba(11, 27, 46, 0.12);
      --read-accent: #2a8f9a;

      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-top: 2.75rem;
      margin-bottom: 0;
      background: var(--read-bg);
      border-top: 1px solid var(--read-border);
    }

    .insight-reading-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4.5rem 2rem 4rem;
    }

    .article-figure {
      width: min(1080px, 100%);
      margin: 2.75rem auto 3.25rem;
    }

    .insight-reading-surface .article-figure img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 0.5rem;
      border: 1px solid var(--read-border);
      background: #ffffff;
      box-shadow: 0 8px 24px rgba(11, 27, 46, 0.08);
      object-fit: contain;
    }

    .insight-reading-surface .article-figure figcaption {
      max-width: 850px;
      margin: 1rem auto 0;
      color: var(--read-muted);
      line-height: 1.5;
    }

    .insight-reading-surface .article-figure figcaption strong {
      color: var(--read-heading);
    }

    .figure-zoom-trigger {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      margin: 0;
      background: none;
      cursor: zoom-in;
      position: relative;
      border-radius: 0.5rem;
    }

    .figure-zoom-trigger:focus-visible {
      outline: 3px solid var(--read-accent);
      outline-offset: 3px;
    }

    .figure-zoom-trigger::after {
      content: "Click to enlarge";
      position: absolute;
      right: 0.85rem;
      bottom: 0.85rem;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      background: rgba(11, 27, 46, 0.72);
      color: #f6f8fb;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 150ms ease, transform 150ms ease;
      pointer-events: none;
    }

    .figure-zoom-trigger:hover::after,
    .figure-zoom-trigger:focus-visible::after {
      opacity: 1;
      transform: translateY(0);
    }

    .figure-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: rgba(4, 8, 15, 0.92);
    }

    .figure-lightbox[hidden] {
      display: none;
    }

    .figure-lightbox__frame {
      max-width: min(1400px, 100%);
      max-height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .figure-lightbox__frame img {
      display: block;
      max-width: 100%;
      max-height: 82vh;
      width: auto;
      height: auto;
      border-radius: 0.5rem;
      background: #ffffff;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      object-fit: contain;
    }

    .figure-lightbox__caption {
      max-width: 850px;
      margin: 0;
      color: #dbe4f0;
      font-size: 0.92rem;
      line-height: 1.5;
      text-align: center;
    }

    .figure-lightbox__close {
      position: fixed;
      top: 1.25rem;
      right: 1.5rem;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(11, 27, 46, 0.85);
      color: #f6f8fb;
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
    }

    .figure-lightbox__close:hover {
      background: rgba(11, 27, 46, 1);
    }

    .figure-lightbox__close:focus-visible {
      outline: 3px solid var(--read-accent, #2f7fc7);
      outline-offset: 2px;
    }

    @media (max-width: 640px) {
      .figure-zoom-trigger::after {
        content: "Tap to enlarge";
        right: 0.6rem;
        bottom: 0.6rem;
        font-size: 0.72rem;
        opacity: 1;
        transform: none;
      }

      .figure-lightbox {
        padding: 1rem;
      }

      .figure-lightbox__frame img {
        max-height: 72vh;
      }

      .figure-lightbox__close {
        top: 0.75rem;
        right: 0.75rem;
        width: 2.5rem;
        height: 2.5rem;
      }
    }

    .executive-summary {
      border: 1px solid var(--read-border);
      border-radius: 0.65rem;
      background: var(--read-bg-panel);
      padding: 1.75rem 2rem;
      max-width: 1080px;
      margin: 0 auto 3.5rem;
      border-top: 3px solid var(--read-accent);
    }

    .executive-summary h2 {
      color: var(--read-heading);
      margin-bottom: 1rem;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .summary-grid div {
      border-left: 3px solid var(--read-accent);
      padding-left: 0.85rem;
    }

    .summary-grid h3 {
      font-size: 1rem;
      margin-bottom: 0.45rem;
      color: var(--read-heading);
    }

    .summary-grid p {
      max-width: none;
      margin-bottom: 0;
      color: var(--read-body);
    }

    .article-body section {
      margin-bottom: 3.6rem;
    }

    .article-body h2 {
      margin-top: 0.35rem;
      padding-top: 0.45rem;
      font-size: 1.8rem;
      color: var(--read-heading);
    }

    .article-body h3 {
      margin-top: 1.8rem;
      font-size: 1.08rem;
      color: #16324a;
    }

    .article-body p,
    .article-body li {
      color: var(--read-body);
      font-size: 1.02rem;
      line-height: 1.72;
    }

    .article-body p {
      max-width: 760px;
      margin-bottom: 1.05rem;
    }

    .article-body ul,
    .article-body ol {
      margin: 0 0 1.3rem;
      padding-left: 1.35rem;
      color: var(--read-body);
    }

    .article-body code {
      padding: 0.12rem 0.32rem;
      border: 1px solid var(--read-border);
      border-radius: 0.25rem;
      background: #eef2f7;
      color: #0b1b2e;
    }

    .article-body blockquote,
    .pull-quote blockquote {
      margin: 1.5rem 0;
      border-left: 3px solid var(--read-accent);
      padding: 0.1rem 0 0.1rem 1rem;
    }

    .article-body blockquote p {
      color: var(--read-heading);
    }

    .article-body a {
      color: var(--read-accent);
    }

    .concept-flow {
      list-style: decimal;
    }

    .concept-flow li {
      margin-bottom: 0.65rem;
    }

    .sources {
      border-top: 1px solid var(--read-border);
      padding-top: 1.8rem;
      margin-bottom: 0;
    }

    .sources h2 {
      color: var(--read-heading);
    }

    .sources ol {
      padding-left: 1.2rem;
    }

    .sources li {
      font-size: 0.95rem;
      color: var(--read-muted);
      margin-bottom: 0.85rem;
    }

    .sources a {
      color: var(--read-accent);
    }

    .article-cta {
      border: 1px solid var(--border-subtle);
      border-radius: 0.5rem;
      background: linear-gradient(160deg, rgba(18, 31, 52, 0.78), rgba(10, 16, 27, 0.94));
      padding: 1.2rem;
      max-width: 780px;
      margin: 0 auto;
    }

    .article-cta p {
      max-width: none;
      margin-bottom: 0;
    }

    .article-cta h2 {
      margin-bottom: 0.85rem;
    }

    .article-cta .page-actions {
      margin-top: 1.2rem;
    }

    @media (max-width: 900px) {
      .article-header h1 {
        font-size: 2.2rem;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .article-header {
        padding-top: 0.5rem;
      }

      .article-header h1 {
        font-size: 1.85rem;
      }

      .article-subtitle,
      .article-body p,
      .article-body li {
        font-size: 1rem;
      }

      .article-featured {
        margin-left: -0.2rem;
        margin-right: -0.2rem;
      }

      .insight-reading-surface {
        margin-top: 1.6rem;
      }

      .insight-reading-inner {
        padding: 2.4rem 1.15rem 2.6rem;
      }
    }

    @media (max-width: 900px) {
      .insight-reading-inner {
        padding: 3.25rem 1.5rem 3.25rem;
      }
    }

    .article-featured figcaption {
      max-width: 850px;
      margin: 0.9rem auto 0;
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .article-body a.footnote-ref {
      font-size: 0.78em;
      vertical-align: super;
      line-height: 0;
      text-decoration: none;
      font-weight: 700;
    }
    .architecture-list, .concept-flow { list-style: decimal; }
    .architecture-list li, .concept-flow li { margin-bottom: 0.65rem; }
    .insight-table-wrap {
      width: 100%;
      max-width: 1080px;
      margin: 1.75rem auto 2.25rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--read-border);
      border-radius: 0.55rem;
      background: var(--read-bg-panel);
      box-shadow: 0 8px 24px rgba(11, 27, 46, 0.06);
    }
    .insight-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    .insight-table th, .insight-table td {
      padding: 0.95rem 1.1rem;
      border-bottom: 1px solid var(--read-border);
      vertical-align: top;
      overflow-wrap: anywhere;
      color: var(--read-body);
    }
    .insight-table th {
      text-align: left;
      color: #f6f8fb;
      background: #0b1b2e;
      border-bottom: 3px solid #2a8f9a;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .insight-table tr:last-child td { border-bottom: 0; }
    .insight-table tbody tr:nth-child(even) td { background: rgba(11, 27, 46, 0.03); }
    .insight-table strong { color: var(--read-heading); }
    .sources .provenance {
      max-width: 760px; color: var(--read-muted); font-size: 0.95rem; margin-bottom: 1.2rem;
    }
    @media (max-width: 900px) {
      .insight-table th, .insight-table td { padding: 0.75rem 0.8rem; font-size: 0.92rem; }
    }
    @media (max-width: 560px) {
      .insight-table th, .insight-table td { padding: 0.65rem 0.7rem; font-size: 0.9rem; }
    }

  </style>

  <script>
    const lightbox = document.querySelector<HTMLDivElement>("[data-lightbox]");
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const lightboxCaption = lightbox?.querySelector<HTMLParagraphElement>("[data-lightbox-caption]");
    const closeButton = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    let lastFocused: HTMLElement | null = null;

    function openLightbox(trigger: HTMLElement) {
      const img = trigger.querySelector("img");
      if (!img || !lightbox || !lightboxImage) return;
      lightboxImage.src = img.getAttribute("src") ?? "";
      lightboxImage.alt = img.getAttribute("alt") ?? "";
      const figure = trigger.closest("figure");
      const caption = figure?.querySelector("figcaption")?.textContent?.trim() ?? "";
      if (lightboxCaption) lightboxCaption.textContent = caption;
      lastFocused = trigger;
      lightbox.hidden = false;
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      closeButton?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      lastFocused?.focus();
    }

    document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => openLightbox(trigger));
    });

    closeButton?.addEventListener("click", closeLightbox);

    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
    });
  </script>
</BaseLayout>
