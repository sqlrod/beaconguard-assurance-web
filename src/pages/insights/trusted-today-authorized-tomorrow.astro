      color: var(--read-body);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .article-body p {
      margin-bottom: 1.1rem;
    }

    .article-body ul,
    .article-body ol {
      margin: 0 0 1.35rem 1.2rem;
    }

    .article-body blockquote {
      margin: 1.5rem 0;
      padding: 1rem 1.25rem;
      border-left: 3px solid var(--read-accent);
      background: var(--read-bg-panel);
      border-radius: 0 0.45rem 0.45rem 0;
    }

    .article-body blockquote p {
      margin-bottom: 0;
      color: var(--read-heading);
    }

    .article-body a {
      color: var(--read-accent);
    }

    .article-body a.footnote-ref {
      font-size: 0.78em;
      font-weight: 700;
      text-decoration: none;
      margin-left: 0.1em;
    }

    .insight-table-wrap {
      width: 100%;
      max-width: 1080px;
      margin: 1.75rem auto 2.25rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--read-border);
      border-radius: 0.55rem;
      background: var(--read-bg-panel);
      box-shadow: 0 8px 24px rgba(11, 27, 46, 0.06);
    }

    .insight-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .insight-table th, .insight-table td {
      padding: 0.95rem 1.1rem;
      border-bottom: 1px solid var(--read-border);
      vertical-align: top;
      overflow-wrap: anywhere;
      color: var(--read-body);
    }

    .insight-table th {
      text-align: left;
      color: #f6f8fb;
      background: #0b1b2e;
      border-bottom: 3px solid #2a8f9a;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .insight-table tr:last-child td { border-bottom: 0; }
    .insight-table tbody tr:nth-child(even) td { background: rgba(11, 27, 46, 0.03); }
    .insight-table strong { color: var(--read-heading); }

    .sources {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--read-border);
    }

    .sources h2 {
      color: var(--read-heading);
    }

    .sources ol {
      padding-left: 1.2rem;
    }

    .sources li {
      margin-bottom: 1rem;
      color: var(--read-body);
      font-size: 0.95rem;
    }

    .sources a {
      word-break: break-all;
    }

    .article-cta {
      margin: 0;
      padding: 3.5rem 1.5rem 4rem;
      background: linear-gradient(160deg, rgba(18, 31, 52, 0.95), rgba(8, 14, 24, 0.98));
      color: #e8eef7;
      text-align: center;
    }

    .article-cta p {
      max-width: 720px;
      margin-left: auto;
      margin-right: auto;
      color: #c5d0df;
    }

    .article-cta h2 {
      margin-bottom: 0.85rem;
      color: #f6f8fb;
    }

    .article-cta .page-actions {
      margin-top: 1.2rem;
      justify-content: center;
    }

    @media (max-width: 900px) {
      .article-header h1 {
        font-size: 2.2rem;
      }
      .insight-reading-inner {
        padding: 3.25rem 1.5rem 3.25rem;
      }
    }

    @media (max-width: 560px) {
      .article-header {
        padding-top: 0.5rem;
      }
      .article-header h1 {
        font-size: 1.85rem;
      }
      .article-subtitle,
      .article-body p,
      .article-body li {
        font-size: 1rem;
      }
      .insight-reading-surface {
        margin-top: 1.6rem;
      }
      .insight-reading-inner {
        padding: 2.4rem 1.15rem 2.6rem;
      }
    }
  </style>

  <script>
    const lightbox = document.querySelector<HTMLDivElement>("[data-lightbox]");
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const lightboxCaption = lightbox?.querySelector<HTMLParagraphElement>("[data-lightbox-caption]");
    const closeButton = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    let lastFocused: HTMLElement | null = null;

    function openLightbox(trigger: HTMLElement) {
      const img = trigger.querySelector("img");
      if (!img || !lightbox || !lightboxImage) return;
      lightboxImage.src = img.getAttribute("src") ?? "";
      lightboxImage.alt = img.getAttribute("alt") ?? "";
      const figure = trigger.closest("figure");
      const caption = figure?.querySelector("figcaption")?.textContent?.trim() ?? "";
      if (lightboxCaption) lightboxCaption.textContent = caption;
      lastFocused = trigger;
      lightbox.hidden = false;
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      closeButton?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      lastFocused?.focus();
    }

    document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => openLightbox(trigger));
    });

    closeButton?.addEventListener("click", closeLightbox);

    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
    });
  </script>
</BaseLayout>
