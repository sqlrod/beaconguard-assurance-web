---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reviewer Kit | BeaconGuard Due Diligence Materials"
  description="BeaconGuard Reviewer Kit: a 12-step sequence covering governed AI transactions, dual authorization, linked decision evidence, Verify capabilities, and shared responsibilities."
>
  <section class="stack-section">
    <h1>Reviewer Kit</h1>
    <p class="lead">
      Control before execution. Evidence after every decision.
    </p>
    <p>
      Use this kit to review BeaconGuard as the independent authorization and
      verification layer for regulated AI actions. Runtime permission results
      are ALLOW or DENY only. An AI-generated result remains an untrusted
      proposal. BeaconGuard Verify is read-only and cannot grant runtime
      authority.
    </p>
  </section>

  <section class="stack-section">
    <h2>12-step reviewer sequence</h2>
    <ol>
      <li>
        Review the governed transaction —
        <a href="/how-it-works">How It Works</a>,
        <a href="/canonical-workflow">Workflow Examples</a>
      </li>
      <li>
        Inspect request admission —
        <a href="/platform">Platform</a>,
        <a href="/security">Security</a>
      </li>
      <li>
        Inspect result-to-action authorization —
        <a href="/platform">Platform</a>,
        <a href="/security">Security</a>
      </li>
      <li>
        Review linked decision evidence —
        <a href="/proof-evidence">Proof and Evidence</a>,
        <a href="/sample-decision-record">Sample Decision Record</a>
      </li>
      <li>
        Open Decision Explorer —
        <a href="/verification">Verification</a>
      </li>
      <li>
        Reconstruct the transaction —
        <a href="/verification">Verification</a>,
        <a href="/docs/compliance-audit">Compliance and Audit</a>
      </li>
      <li>
        Inspect source evidence —
        <a href="/verification">Verification</a>,
        <a href="/proof-evidence">Proof and Evidence</a>
      </li>
      <li>
        Verify replay —
        <a href="/verification">Verification</a>
      </li>
      <li>
        Validate export —
        <a href="/verification">Verification</a>
      </li>
      <li>
        Inspect report provenance —
        <a href="/verification">Verification</a>,
        <a href="/docs/compliance-audit">Compliance and Audit</a>
      </li>
      <li>
        Confirm AI insights are non-authoritative —
        <a href="/verification">Verification</a>,
        <a href="/trust-assurance">Trust Center</a>
      </li>
      <li>
        Review shared responsibilities —
        <a href="/control-responsibility-matrix">Control Responsibility Matrix</a>,
        <a href="/trust-assurance">Trust Center</a>
      </li>
    </ol>
  </section>

