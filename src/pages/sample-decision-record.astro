---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecordAnatomy from "../components/diagrams/RecordAnatomy.astro";
---

<BaseLayout
  title="Sample Decision Record | BeaconGuard Assurance"
  description="A sanitized illustrative BeaconGuard consequential-action authorization record showing exact-action identity, governing release identity, delegated authority context, and DENY enforcement."
>
  <section class="stack-section">
    <h1>Sample Decision Record</h1>
    <p class="lead">
      This sample shows the categories of evidence BeaconGuard preserves around a consequential-action decision. It is illustrative, synthetic, and not a normative public API schema.
    </p>
  </section>

  <section class="stack-section">
    <h2>Record anatomy</h2>
    <RecordAnatomy />
  </section>

  <section class="stack-section">
    <h2>Illustrative DENY record</h2>
    <div class="sample-record sample-record--compact">
      <div class="sample-record-row">
        <span class="sample-record-label">Decision scope</span>
        <span class="sample-record-value">CONSEQUENTIAL_ACTION</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">Decision outcome</span>
        <span class="sample-record-value">ACTION DENY</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">Reason</span>
        <span class="sample-record-value">Required approval absent for the proposed side effect</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">Material action</span>
        <span class="sample-record-value">patient_followup.schedule</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">material_action_digest</span>
        <span class="sample-record-value">sha256:illustrative-action-digest</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">release_identity</span>
        <span class="sample-record-value">release.healthcare.ops.v12</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">release_manifest_identity</span>
        <span class="sample-record-value">sha256:illustrative-release-manifest</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">playbook_identity</span>
        <span class="sample-record-value">playbook.healthcare.followup.v12</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">Actor / agent context</span>
        <span class="sample-record-value">Synthetic delegated discharge-operations agent</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">Execution authority</span>
        <span class="sample-record-value">NOT ISSUED</span>
      </div>
      <div class="sample-record-row">
        <span class="sample-record-label">Outcome</span>
        <span class="sample-record-value">No scheduling side effect</span>
      </div>
    </div>
  </section>

  <section class="stack-section">
    <h2>What reviewers should notice</h2>
    <ul>
      <li>The evidence describes the action decision, not the business transaction itself.</li>
      <li>The exact material action has a deterministic identity separate from the original request.</li>
      <li>The record identifies the verified release / policy authority that governed the decision.</li>
      <li>Actor and delegated-authority context are decision inputs, not substitutes for the action decision.</li>
      <li>DENY issues no execution authority.</li>
      <li>ALLOW records can additionally identify a one-time execution grant and its consumption state.</li>
    </ul>
  </section>

  <section class="stack-section">
    <h2>Next step</h2>
    <div class="page-actions">
      <a class="btn-primary" href="/proof-evidence">View Proof and Evidence</a>
      <a class="btn-secondary" href="/trust-assurance">Review Assurance</a>
      <a class="btn-secondary" href="/reviewer-kit">Reviewer Kit</a>
    </div>
  </section>
</BaseLayout>
