            <td>Supporting</td>
          </tr>
          <tr>
            <td>Evidence clarity</td>
            <td>Supporting</td>
            <td>Supporting</td>
            <td>Primary strength</td>
          </tr>
          <tr>
            <td>Trust-boundary clarity</td>
            <td>High — labeled ports and zones</td>
            <td>High — runtime / verify labeled</td>
            <td>High — read-only Verify boundary</td>
          </tr>
          <tr>
            <td>Executive comprehension</td>
            <td>Medium–High</td>
            <td>High</td>
            <td>High for reviewers</td>
          </tr>
          <tr>
            <td>Mobile behavior</td>
            <td>Vertical circuit stack</td>
            <td>Authorize-dominant stack</td>
            <td>Provenance stack</td>
          </tr>
          <tr>
            <td>Intended pages</td>
            <td>Home / How It Works / Canonical / industries</td>
            <td>Platform / overview</td>
            <td>Verify / Proof / Audit / Reviewer Kit</td>
          </tr>
          <tr>
            <td>Known limitations</td>
            <td>Dense labels mid-width</td>
            <td>No full loop</td>
            <td>Illustrative only</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3>Family-consistency standards</h3>
    <div class="docs-table-wrap">
      <table class="dir-eval dir-eval--wide">
        <thead>
          <tr>
            <th>Shared standard</th>
            <th>View A</th>
            <th>View B</th>
            <th>View C</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>8-point grid</td>
            <td>PASS</td>
            <td>PASS</td>
            <td>PASS</td>
          </tr>
          <tr>
