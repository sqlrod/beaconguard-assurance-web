---
/**
 * Staging-only unified enterprise diagram system review.
 * Specialized views A/B/C — not competing universal candidates.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import OrthographicSecurityCircuit from "../components/diagrams/directions/OrthographicSecurityCircuit.astro";
import LayeredControlArchitecture from "../components/diagrams/directions/LayeredControlArchitecture.astro";
import EvidenceCenteredInvestigation from "../components/diagrams/directions/EvidenceCenteredInvestigation.astro";
import DiagramIcon from "../components/diagrams/primitives/DiagramIcon.astro";
---

<BaseLayout
  title="Staging · Unified enterprise diagram system | BeaconGuard"
  description="Staging-only validation of the unified BeaconGuard diagram visual language across three specialized architectural views."
  noindex={true}
>
  <section class="staging-banner" role="note">
    <strong>STAGING ONLY</strong>
    <p>
      This route exists only on the staging redesign branch for unified diagram
      system review. It is noindex, excluded from the sitemap, and not linked from
      primary navigation or the footer. Views A, B, and C are specialized
      architectural views — not competing universal winners. No site-wide
      deployment was performed in this pass.
    </p>
  </section>

  <section class="stack-section">
    <h1>Unified enterprise diagram system</h1>
    <p class="lead">
      One BeaconGuard visual language expressed through three specialized
      architectural views. Framework: Astro, semantic HTML, CSS, and authored SVG.
      No graph editor runtime.
    </p>
  </section>

  <section class="stack-section" id="system-overview">
    <h2>1. Unified visual-system overview</h2>
    <p>
      Shared 8-point grid, typography hierarchy, vendor-neutral icons, semantic
      decision colors, connector weights, and trust-boundary language. Each view
      specializes the same system for a different architectural purpose.
    </p>
    <ul class="sys-token-list">
      <li>Grid: <code>--diagram-space-1</code> … <code>--diagram-space-8</code></li>
      <li>Surfaces: <code>--diagram-surface</code>, <code>--diagram-surface-raised</code></li>
      <li>Borders: <code>--diagram-border</code>, <code>--diagram-border-strong</code></li>
      <li>
        Boundaries: enterprise · runtime · provider · verify
      </li>
      <li>
        Connectors: <code>--connector-neutral</code>, <code>--connector-allow</code>,
        <code>--connector-deny</code>, <code>--connector-evidence</code>
      </li>
      <li>
        Decisions: DENY (highest alert) · ALLOW (muted secure green) · Evidence (teal)
      </li>
    </ul>
  </section>

  <section class="stack-section" id="shared-primitives">
    <h2>2. Shared tokens and primitives</h2>
    <div class="sys-icon-row" aria-hidden="true">
      <span class="sys-icon-chip"><DiagramIcon name="app" /> App</span>
      <span class="sys-icon-chip"><DiagramIcon name="provider" /> Provider</span>
      <span class="sys-icon-chip"><DiagramIcon name="shield" /> Checkpoint</span>
      <span class="sys-icon-chip"><DiagramIcon name="database" /> System of record</span>
      <span class="sys-icon-chip"><DiagramIcon name="evidence" /> Decision record</span>
      <span class="sys-icon-chip"><DiagramIcon name="verify" /> Verification</span>
      <span class="sys-icon-chip"><DiagramIcon name="export" /> Export</span>
      <span class="sys-icon-chip"><DiagramIcon name="deny" /> Denial</span>
      <span class="sys-icon-chip"><DiagramIcon name="release" /> Release</span>
    </div>
    <p>
      Icons are secondary to labels, decorative by default (<code>aria-hidden</code>),
      and do not imply unsupported cryptographic or physical properties.
    </p>
  </section>

  <section class="stack-section dir-section" id="direction-a" data-crop="direction-a">
    <h2>3. View A — Orthographic Security Circuit</h2>
    <p>
      Purpose: transaction authorization and fail-closed control.
    </p>
    <OrthographicSecurityCircuit idPrefix="sys-a" />
    <div class="dir-compact-wrap">
      <h4 class="dir-compact-label">Compact / stacked demonstration</h4>
      <OrthographicSecurityCircuit compact={true} idPrefix="sys-a-c" />
    </div>
    <details class="bg-disclose">
      <summary>Inspect technical structure</summary>
      <div class="bg-disclose-body">
        <p><strong>Architecture purpose:</strong> Closed governed AI transaction with dual authorization checkpoints.</p>
        <p><strong>Component inventory:</strong> Prepare, Receive+Declare, Execute, Request Admission, AI Provider, Result-to-Action, System of Record, Evidence rail, Verify.</p>
        <p><strong>Path inventory:</strong> Outbound → Request Admission → Invoke → Return into application → Declared action → ALLOW→Execute → SoR; REQUEST DENY terminal; ACTION DENY terminal; evidence to Verify.</p>
        <p><strong>Text equivalent:</strong> See figure caption (screen-reader accessible).</p>
        <p><strong>Intended pages:</strong> Homepage compact visual, How It Works, Canonical Workflow, Healthcare, Financial Services, Use Cases, Controlled Evaluation transaction summary.</p>
        <p><strong>Known limitations:</strong> Dense path labels at mid widths; desktop circuit must stack on mobile rather than shrink.</p>
      </div>
    </details>
  </section>

  <section class="stack-section dir-section" id="direction-b" data-crop="direction-b">
    <h2>4. View B — Layered Control Architecture</h2>
    <p>
      Purpose: functional platform architecture for executive comprehension.
    </p>
    <LayeredControlArchitecture idPrefix="sys-b" />
    <details class="bg-disclose">
      <summary>Inspect technical structure</summary>
      <div class="bg-disclose-body">
        <p><strong>Architecture purpose:</strong> Govern → Authorize → Verify as functional domains.</p>
        <p><strong>Component inventory:</strong> Playbooks, validation, signed/active release; dual authorization; explorer, reconstruction, source evidence, replay, export, non-authoritative insights.</p>
        <p><strong>Path inventory:</strong> Verified release into Authorize; evidence outward to Verify; no permission return.</p>
        <p><strong>Intended pages:</strong> Platform, executive system architecture, company overview where appropriate, pitch-deck architecture summary.</p>
        <p><strong>Known limitations:</strong> Does not communicate full transaction geometry; must not be read as physical plane separation.</p>
      </div>
    </details>
  </section>

  <section class="stack-section dir-section" id="direction-c" data-crop="direction-c">
    <h2>5. View C — Evidence-Centered Investigation</h2>
    <p>
      Purpose: verification, investigation, audit, and evidence.
    </p>
    <EvidenceCenteredInvestigation idPrefix="sys-c" />
    <div class="dir-compact-wrap">
      <h4 class="dir-compact-label">Compact / stacked demonstration</h4>
      <EvidenceCenteredInvestigation compact={true} idPrefix="sys-c-c" />
    </div>
    <details class="bg-disclose">
      <summary>Inspect technical structure</summary>
      <div class="bg-disclose-body">
        <p><strong>Architecture purpose:</strong> Decision context → canonical evidence → review outputs inside a read-only Verify boundary.</p>
        <p><strong>Component inventory:</strong> Dual decisions, release/playbook/correlation identities, VDRs, source evidence, integrity/replay/reconstruction status, explorer, reconstruction, reporting, export, separated AI insights.</p>
        <p><strong>Path inventory:</strong> Context → Evidence → Outputs; source evidence supports reconstruction; export derives from canonical evidence; no return to runtime authority.</p>
        <p><strong>Intended pages:</strong> Verification, Proof and Evidence, Compliance and Audit, Reviewer Kit, Sample Decision Record, Trust Center evidence summary where appropriate.</p>
        <p><strong>Known limitations:</strong> Illustrative model only — not a live product screenshot.</p>
      </div>
    </details>
  </section>

  <section class="stack-section" id="cross-family">
    <h2>6. Cross-family consistency evaluation</h2>
    <p>
      Each view is scored against its assigned purpose. Views are not ranked as
      universal competitors.
    </p>
    <div class="docs-table-wrap">
      <table class="dir-eval dir-eval--wide">
        <thead>
          <tr>
            <th>Criterion</th>
            <th>View A</th>
            <th>View B</th>
            <th>View C</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Assigned purpose</td>
            <td>Transaction authorization</td>
            <td>Functional platform domains</td>
            <td>Verification / evidence</td>
          </tr>
          <tr>
            <td>Transaction clarity</td>
            <td>Primary strength</td>
            <td>Not primary purpose</td>
            <td>Not primary purpose</td>
          </tr>
          <tr>
            <td>Functional-domain clarity</td>
            <td>Supporting</td>
