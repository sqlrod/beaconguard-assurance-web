          </tr>
          <tr>
            <td>Connector weights</td>
            <td>PASS</td>
            <td>PASS (flow labels)</td>
            <td>PASS (flow arrows)</td>
          </tr>
          <tr>
            <td>Boundary language</td>
            <td>PASS</td>
            <td>PASS</td>
            <td>PASS</td>
          </tr>
          <tr>
            <td>Responsive behavior</td>
            <td>PASS</td>
