---
/**
 * Staging-only unified diagram system — Pass 01B-R2 pure-SVG rebuild.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import OrthographicSecurityCircuit from "../components/diagrams/directions/OrthographicSecurityCircuit.astro";
import LayeredControlArchitecture from "../components/diagrams/directions/LayeredControlArchitecture.astro";
import EvidenceCenteredInvestigation from "../components/diagrams/directions/EvidenceCenteredInvestigation.astro";
---

<BaseLayout
  title="Staging · Pure-SVG diagram rebuild | BeaconGuard"
  description="Staging-only Pass 01B-R2 pure-SVG production-candidate diagram rebuild."
  noindex={true}
>
  <section class="staging-banner" role="note">
    <strong>STAGING ONLY · PASS 01B-R2</strong>
    <p>
      Pure-SVG rebuild. noindex, excluded from sitemap, not linked from navigation
      or footer. Mixed HTML/SVG positioning removed. No site-wide adoption. Pass
      01C remains unauthorized pending independent visual review.
    </p>
  </section>

  <section class="stack-section">
    <h1>Pure-SVG production-candidate diagram rebuild</h1>
    <p class="lead">
      Self-contained SVG coordinate systems for Views A, B, and C plus homepage
      and Verification executive visuals. Desktop and compact variants are
      separately authored diagrams — not scaled-down desktops or list fallbacks.
    </p>
    <p><code>IMPLEMENTATION_COMPLETE_PENDING_INDEPENDENT_VISUAL_REVIEW</code></p>
  </section>

  <section class="stack-section" id="r2-architecture">
    <h2>Rendering architecture</h2>
    <ul>
      <li>Nodes, connectors, boundaries, and labels share one SVG viewBox.</li>
      <li>No HTML absolute positioning over SVG paths.</li>
      <li>No ordered-list mobile replacement.</li>
      <li>No foreignObject, React Flow, Mermaid, D3, Dagre, or ELK.</li>
    </ul>
  </section>

  <section class="stack-section dir-section" id="direction-a" data-crop="direction-a">
    <h2>View A — Orthographic Security Circuit</h2>
    <p>
      Purpose: transaction authorization. R1 defect: HTML nodes over SVG paths
      caused clipping, DENY overlap, and list-like mobile output. R2 correction:
      pure-SVG desktop circuit + compact vertical circuit with DENY side
      terminals. Independent-review status: <strong>PENDING</strong>.
    </p>
    <OrthographicSecurityCircuit idPrefix="sys-a" title="Governed AI transaction circuit" />
    <div class="dir-compact-wrap">
      <h4 class="dir-compact-label">Forced compact variant</h4>
      <OrthographicSecurityCircuit compact={true} idPrefix="sys-a-c" title="Compact transaction circuit" />
    </div>
    <details class="bg-disclose">
      <summary>Inspect technical structure</summary>
      <div class="bg-disclose-body">
        <p>Ports: REQUEST OUT, RESULT IN, ACTION OUT, EXECUTION IN, SYSTEM EFFECT OUT.</p>
        <p>Paths: outbound, invoke, return-to-application, declared action, ALLOW→Execute, system effect, dual DENY terminals, evidence bus.</p>
      </div>
    </details>
  </section>

  <section class="stack-section dir-section" id="direction-b" data-crop="direction-b">
    <h2>View B — Layered Control Architecture</h2>
    <p>
      Purpose: functional platform domains. R1 defect: three documentation cards
      with list spines and hidden connectors. R2 correction: pure-SVG layered
      composition with authored release and evidence connectors. Independent-review
      status: <strong>PENDING</strong>.
    </p>
    <LayeredControlArchitecture idPrefix="sys-b" title="Govern · Authorize · Verify" />
    <div class="dir-compact-wrap">
      <h4 class="dir-compact-label">Forced compact variant</h4>
      <LayeredControlArchitecture compact={true} idPrefix="sys-b-c" title="Compact functional sequence" />
    </div>
  </section>

  <section class="stack-section dir-section" id="direction-c" data-crop="direction-c">
    <h2>View C — Evidence-Centered Investigation</h2>
    <p>
      Purpose: verification and evidence. R1 defect: ambiguous decision-to-record
      binding and AI insights inserted into provenance. R2 correction: pure-SVG
      ledger with correct bindings and AI annex outside trusted sequence.
      Independent-review status: <strong>PENDING</strong>.
    </p>
    <EvidenceCenteredInvestigation idPrefix="sys-c" title="Evidence-centered investigation" />
    <div class="dir-compact-wrap">
      <h4 class="dir-compact-label">Forced compact variant</h4>
      <EvidenceCenteredInvestigation compact={true} idPrefix="sys-c-c" title="Compact evidence provenance" />
    </div>
  </section>

  <section class="stack-section" id="mapping">
    <h2>Intended page mapping</h2>
    <ul>
      <li><strong>View A:</strong> Home compact, How It Works, Canonical, Healthcare, Financial, Use Cases, Controlled Evaluation.</li>
      <li><strong>View B:</strong> Platform, executive architecture, company overview, pitch deck.</li>
      <li><strong>View C:</strong> Verification, Proof, Compliance/Audit, Reviewer Kit, Sample Decision Record.</li>
    </ul>
    <p>No universal winner. No site-wide diagram adoption occurred. Pass 01C remains unauthorized pending independent visual review.</p>
  </section>
</BaseLayout>
