---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceLifecycle from "../components/diagrams/EvidenceLifecycle.astro";
---
<BaseLayout
  title="Assurance | BeaconGuard Trust and Verification"
  description="Review how BeaconGuard verifies policy authority, binds authorization to exact actions, preserves evidence, and supports deterministic reconstruction."
>
  <section class="stack-section">
    <p class="section-label">ASSURANCE</p>
    <h1>Authorize the action. Prove the decision.</h1>
    <p class="lead">BeaconGuard connects the exact action, the authority allowed to govern it, the runtime decision, and the evidence needed to verify that decision afterward.</p>
  </section>
  <section class="stack-section">
    <h2>The authorization assurance chain</h2>
    <EvidenceLifecycle />
  </section>
  <section class="stack-section">
    <h2>What reviewers can verify</h2>
    <div class="section-grid section-grid--compact">
      <div class="content-card"><h3>Policy authority</h3><p>Which approved and verified release governed the authorization decision.</p></div>
      <div class="content-card"><h3>Exact action</h3><p>Which consequential action was evaluated and bound to execution authority.</p></div>
      <div class="content-card"><h3>Decision evidence</h3><p>Which actor/delegation context, outcome, and integrity information support reconstruction.</p></div>
    </div>
  </section>
  <section class="stack-section">
    <h2>Technical review</h2>
    <div class="page-actions"><a class="btn-primary" href="/proof-evidence">Proof and Evidence</a><a class="btn-secondary" href="/docs/architecture">Architecture</a><a class="btn-secondary" href="/design-partner-program">Request Evaluation</a></div>
  </section>
</BaseLayout>
