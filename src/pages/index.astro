---
import BaseLayout from "../layouts/BaseLayout.astro";
import ControlBoundaryOverview from "../components/diagrams/ControlBoundaryOverview.astro";
---

<BaseLayout
  title="BeaconGuard Assurance | Authorization for Consequential AI Actions"
  description="BeaconGuard independently authorizes consequential AI actions before execution, fails closed when they are not authorized, and preserves verifiable evidence tied to the governing policy authority."
>
  <section class="landing landing--compressed">
    <p class="hero-eyebrow">Independent authorization for consequential AI actions</p>
    <h1>AI can take action. BeaconGuard decides if it should.</h1>
    <p class="hero-subheadline">
      BeaconGuard checks the exact consequential action an AI or agent is attempting before execution. If it is not authorized, it does not happen.
    </p>
    <div class="page-actions">
      <a class="btn-primary" href="/platform">See the Product</a>
      <a class="btn-secondary" href="/design-partner-program">Request Evaluation</a>
    </div>
    <ControlBoundaryOverview />
  </section>

  <section class="stack-section homepage-block">
    <p class="section-label">THE CONTROL GAP</p>
    <h2>Access is not authority</h2>
    <p>
      Identity, delegation, and tool access establish reachability and context. BeaconGuard makes a separate authorization decision on the business consequence itself.
    </p>
    <p class="home-principle"><strong>Request ALLOW does not equal Action ALLOW.</strong></p>
  </section>

  <section class="stack-section homepage-block">
    <p class="section-label">WHY BEACONGUARD</p>
    <h2>Authorize the action. Prove the decision.</h2>
    <div class="section-grid section-grid--compact">
      <div class="content-card">
        <h3>Action-level authority</h3>
        <p>Permission to use a tool does not mean permission to perform every action it can trigger. BeaconGuard authorizes the specific action before execution.</p>
      </div>
      <div class="content-card">
        <h3>Verified authority</h3>
        <p>Only approved and verified customer controls can govern production authorization.</p>
      </div>
      <div class="content-card">
        <h3>Verifiable evidence</h3>
        <p>Each decision preserves the action and governing authority needed for later verification.</p>
      </div>
    </div>
  </section>

  <section class="stack-section homepage-block product-overview-section">
    <p class="section-label">2-MINUTE OVERVIEW</p>
    <h2>See the operating model</h2>
    <div class="product-overview-video product-overview-video--compact">
      <iframe
        src="https://www.youtube-nocookie.com/embed/OzPMIQ_NHho"
        title="BeaconGuard product overview"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section class="stack-section homepage-block">
    <p class="section-label">INDUSTRIES</p>
    <h2>Same authorization boundary. Different consequences.</h2>
    <div class="section-grid section-grid--compact">
      <div class="content-card">
        <h3>Healthcare</h3>
        <p>Patient communications, scheduling actions, and operational record changes.</p>
        <p><a href="/healthcare">Healthcare</a></p>
      </div>
      <div class="content-card">
        <h3>Financial services</h3>
        <p>Case actions, customer communications, and account or workflow side effects.</p>
        <p><a href="/fintech">Financial services</a></p>
      </div>
    </div>
  </section>

  <section class="stack-section homepage-block">
    <p class="section-label">CONTROLLED EVALUATION</p>
    <h2>Start with one consequential workflow</h2>
    <p>Evaluate boundary placement, exact-action controls, evidence, and deployment fit without replacing existing systems of record.</p>
    <div class="page-actions">
      <a class="btn-primary" href="/design-partner-program">Request Evaluation</a>
      <a class="btn-secondary" href="/trust-assurance">Review Assurance</a>
    </div>
  </section>

  <style>
    .landing--compressed { padding-bottom: 1rem; }
    .landing--compressed .figma-diagram { margin-top: 2rem; }
    .homepage-block { overflow-wrap:anywhere; word-break:break-word; }
    .home-principle { max-width:760px; margin-top:1rem; padding:.85rem 1rem; border-left:3px solid var(--brand-accent); border-radius:.45rem; background:rgba(18,31,52,.72); color:var(--text-primary); }
    .product-overview-section { margin:0 auto 3rem; }
    .product-overview-video--compact { width:min(680px,100%); margin:1rem auto 0; aspect-ratio:16/9; overflow:hidden; border:1px solid rgba(148,163,184,.28); border-radius:.6rem; background:#0b1220; }
    .product-overview-video--compact iframe { display:block; width:100%; height:100%; border:0; }
  </style>
</BaseLayout>
