---
import BaseLayout from "../layouts/BaseLayout.astro";
import GovernedAITransaction from "../components/diagrams/GovernedAITransaction.astro";
import GovernAuthorizeVerify from "../components/diagrams/GovernAuthorizeVerify.astro";
import VerificationHierarchy from "../components/diagrams/VerificationHierarchy.astro";
import QualificationNotice from "../components/QualificationNotice.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
---

<BaseLayout
  title="BeaconGuard Assurance | Control before execution"
  description="Control before execution. Evidence after every decision. BeaconGuard governs whether an enterprise application may invoke AI and whether a declared action based on the returned result may affect an enterprise system."
>
  <section class="landing landing--brand">
    <p class="hero-eyebrow">INDEPENDENT AI ACTION AUTHORIZATION</p>
    <h1>
      Control before execution.<br />
      Evidence after every decision.
    </h1>
    <p class="hero-subheadline">
      BeaconGuard governs whether an enterprise application may invoke AI and
      whether a declared action based on the returned result may affect an
      enterprise system. The AI-generated result remains an untrusted proposal
      until that action is independently authorized.
    </p>
    <p class="hero-proof">
      Provider success is not enterprise authorization.
    </p>
    <div class="page-actions page-actions--hero">
      <a class="btn-primary" href="/how-it-works">See How It Works</a>
      <a class="btn-secondary" href="/verification">Explore Verification</a>
      <a class="text-link" href="/design-partner-program">Review Controlled Evaluation</a>
    </div>
  </section>

  <section class="stack-section homepage-block homepage-band">
    <p class="section-label">Product category</p>
    <h2>Independent authorization and verification for regulated AI actions</h2>
    <p>
      BeaconGuard authorizes. The enterprise application executes. Systems of
      record remain authoritative. Runtime outcomes are ALLOW or DENY only.
    </p>
  </section>

  <section class="stack-section homepage-block">
    <h2>Complete governed AI transaction</h2>
    <p>
      Reaching the AI provider is not the final governed outcome. Enterprise
      effect still requires independent action authorization.
    </p>
    <GovernedAITransaction />
  </section>

  <section class="stack-section homepage-block">
    <h2>Two authorization points</h2>
    <div class="feature-grid">
      <article class="feature-card">
        <h3>Request Admission Authorization</h3>
        <p>
          Determines whether an application may invoke the AI provider under
          the Active Verified Release. DENY blocks provider invocation. ALLOW
          permits it for that governed request.
        </p>
      </article>
      <article class="feature-card">
        <h3>Result-to-Action Authorization</h3>
        <p>
          After the AI result returns as an untrusted proposal, the application
          declares the intended action. BeaconGuard authorizes or denies that
          declared action — not the semantic correctness of the model output.
        </p>
      </article>
    </div>
  </section>

  <section class="stack-section homepage-block">
    <h2>Govern · Authorize · Verify</h2>
    <GovernAuthorizeVerify />
  </section>

  <section class="stack-section homepage-block">
    <h2>BeaconGuard Verify</h2>
    <p>
      Inspect decisions without changing authority. Verify is read-only and
      cannot grant runtime permission or mutate historical decisions.
    </p>
    <VerificationHierarchy />
    <div class="page-actions">
      <a class="btn-primary" href="/verification">Explore Verification</a>
      <a class="btn-secondary" href="/proof-evidence">Inspect Proof and Evidence</a>
    </div>
  </section>

  <section class="stack-section homepage-block">
    <h2>Healthcare is the initial market</h2>
    <p>
      Patient communication, clinical documentation assistance, and
      care-operations workflows are the initial wedge. BeaconGuard does not
      replace clinical judgment, certify medical accuracy, or replace an EHR.
    </p>
    <div class="page-actions">
      <a class="btn-primary" href="/healthcare">Review Healthcare Scenarios</a>
      <a class="btn-secondary" href="/fintech">Financial Services Expansion</a>
    </div>
  </section>

  <section class="stack-section homepage-block">
    <h2>Proof and evidence</h2>
    <p>
      Authorization decisions produce Verifiable Decision Records for
      investigation, reconstruction, replay verification, reporting, and
      export — without turning verification into a runtime permission path.
    </p>
    <div class="page-actions">
      <a class="btn-primary" href="/proof-evidence">Inspect Proof and Evidence</a>
      <a class="btn-secondary" href="/sample-decision-record">View Sample Decision Record</a>
    </div>
  </section>

  <section
    class="stack-section homepage-block product-overview-section"
    aria-labelledby="product-overview-title"
  >
    <div class="product-overview-heading">
      <p class="section-label">Product Overview</p>
      <h2 id="product-overview-title">
        Runtime assurance for AI in regulated industries
      </h2>
      <p>
        This overview explains BeaconGuard’s purpose and operating model. It is
        not a live product demonstration.
      </p>
    </div>
    <VideoEmbed
      videoId="OzPMIQ_NHho"
      title="BeaconGuard product overview: Runtime assurance for AI in regulated industries"
      watchLabel="Watch the product overview on YouTube"
    />
  </section>

  <section class="stack-section homepage-block cta-band">
    <h2>Controlled Evaluation</h2>
    <p>
      Review representative requests, provider results, intended actions,
      evidence, reconstruction, replay, export, and deployment boundaries
      before production claims.
    </p>
    <div class="page-actions">
      <a class="btn-primary" href="/design-partner-program">Review Controlled Evaluation</a>
      <a class="btn-secondary" href="/contact">Contact</a>
    </div>
  </section>

  <QualificationNotice variant="full" />
</BaseLayout>
