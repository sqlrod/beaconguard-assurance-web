---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTransactionInterim from "../components/diagrams/HeroTransactionInterim.astro";
import GovernedTransactionLoop from "../components/diagrams/GovernedTransactionLoop.astro";
import GovernAuthorizeVerify from "../components/diagrams/GovernAuthorizeVerify.astro";
import QualificationNotice from "../components/QualificationNotice.astro";
---

<BaseLayout
  title="BeaconGuard Assurance | Control before execution"
  description="Control before execution. Evidence after every decision. BeaconGuard governs whether an enterprise application may invoke AI and whether a declared action based on the returned result may affect an enterprise system."
>
  <section class="hero-split hero-split--home">
    <div class="hero-split-copy">
      <p class="hero-eyebrow">INDEPENDENT AI ACTION AUTHORIZATION</p>
      <h1>
        <span class="hero-line">Control before execution.</span>
        <span class="hero-line">Evidence after every decision.</span>
      </h1>
      <p class="hero-subheadline">
        BeaconGuard governs whether an enterprise application may invoke AI and
        whether a declared action based on the returned result may affect an
        enterprise system. The returned AI result remains an untrusted proposal
        until its intended use is independently authorized.
      </p>
      <p class="hero-proof">
        Provider success is not enterprise authorization.
      </p>
      <div class="page-actions page-actions--hero page-actions--hero-split">
        <a class="btn-primary" href="/design-partner-program">Request Controlled Evaluation</a>
        <a class="btn-secondary" href="/how-it-works">See How It Works</a>
        <a class="text-link" href="/verification">Explore Verification</a>
      </div>
    </div>
    <div class="hero-split-visual">
      <HeroTransactionInterim />
    </div>
  </section>

  <section class="stack-section homepage-block marketing-section">
    <h2>Governed AI transaction</h2>
    <p>
      One complete cycle: the enterprise application prepares a request,
      receives an untrusted AI result inside the same application boundary,
      declares an intended action, and executes only after independent
      authorization.
    </p>
    <div class="feature-grid">
      <article class="feature-card">
        <h3>Request Admission Authorization</h3>
        <p>
          Determines whether an application may invoke the AI provider under
          the Active Verified Release. DENY blocks provider invocation.
        </p>
      </article>
      <article class="feature-card">
        <h3>Result-to-Action Authorization</h3>
        <p>
          After the AI result returns as an untrusted proposal, the application
          declares the intended action. BeaconGuard authorizes or denies that
          declared action — not model-content correctness.
        </p>
      </article>
    </div>
    <details class="bg-disclose">
      <summary>View Transaction Architecture</summary>
      <div class="bg-disclose-body">
        <GovernedTransactionLoop
          variant="detailed"
          title="Governed transaction architecture"
          caption="Detailed closed-loop geometry with labeled trust boundaries, dual DENY hard stops, and a separate evidence rail."
        />
        <div class="page-actions">
          <a class="btn-secondary" href="/how-it-works">See How It Works</a>
          <a class="btn-secondary" href="/canonical-workflow">Canonical Workflow</a>
        </div>
      </div>
    </details>
  </section>

  <section class="stack-section homepage-block marketing-section">
    <h2>Govern · Authorize · Verify</h2>
    <GovernAuthorizeVerify />
  </section>

  <section class="stack-section homepage-block marketing-section">
    <p class="section-label">PRIORITY REGULATED WORKFLOWS</p>
    <h2>Priority regulated workflows</h2>
    <p>
      BeaconGuard is evaluating bounded workflows across healthcare, financial
      services, and regulated internal automation.
    </p>
    <div class="feature-grid feature-grid--three">
      <article class="feature-card">
        <h3>Healthcare</h3>
        <p>
          PHI-sensitive operational pathways such as patient communication,
          documentation assistance, and care-operations routing.
        </p>
        <p><a href="/healthcare">Review healthcare workflows</a></p>
      </article>
      <article class="feature-card">
        <h3>Financial Services</h3>
        <p>
          AML, KYC, fraud, dispute, and recommendation workflows where declared
          actions must be authorized before enterprise effect.
        </p>
        <p><a href="/fintech">Review financial workflows</a></p>
      </article>
      <article class="feature-card">
        <h3>Regulated Internal Automation</h3>
        <p>
          Fail-closed authorization before agents or automations produce
          enterprise effect.
        </p>
        <p><a href="/canonical-workflow">Review the canonical workflow</a></p>
      </article>
    </div>
  </section>

  <section class="stack-section homepage-block marketing-section">
    <h2>Verification and evidence</h2>
    <p>
      Authorization decisions produce Verifiable Decision Records for
      investigation, reconstruction, replay verification, reporting, and
      export. Verify is read-only and cannot grant runtime permission.
    </p>
    <div class="page-actions">
      <a class="btn-secondary" href="/verification">Explore Verification</a>
      <a class="btn-secondary" href="/proof-evidence">Inspect Proof and Evidence</a>
    </div>
  </section>

  <section class="stack-section homepage-block cta-band marketing-section">
    <h2>Controlled Evaluation</h2>
    <p>
      Review representative requests, provider results, intended actions,
      evidence, reconstruction, replay, export, and deployment boundaries
      before production claims.
    </p>
    <div class="page-actions">
      <a class="btn-primary" href="/design-partner-program">Request Controlled Evaluation</a>
      <a class="btn-secondary" href="/contact">Contact</a>
    </div>
  </section>

  <QualificationNotice variant="full" />
</BaseLayout>
