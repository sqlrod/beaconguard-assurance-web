---
interface Props {
  name:
    | "app"
    | "provider"
    | "database"
    | "shield"
    | "deny"
    | "evidence"
    | "verify"
    | "identity";
  label?: string;
  decorative?: boolean;
}

const { name, label, decorative = true } = Astro.props;
const title = label || name;
---

<span
  class:list={["bg-dicon", `bg-dicon--${name}`]}
  aria-hidden={decorative ? "true" : undefined}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : title}
>
  {
    name === "app" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <rect x="3" y="4" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M3 8h18" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="6.5" cy="6" r="0.8" fill="currentColor" />
        <circle cx="9" cy="6" r="0.8" fill="currentColor" />
      </svg>
    )
  }
  {
    name === "provider" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <path
          d="M7 17a4 4 0 0 1 0-8 5 5 0 0 1 9.7-1.5A3.5 3.5 0 1 1 17 17H7z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
      </svg>
    )
  }
  {
    name === "database" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <ellipse cx="12" cy="6" rx="7" ry="3" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )
  }
  {
    name === "shield" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <path
          d="M12 3l7 3v5c0 4.4-2.9 8.2-7 9.5C7.9 19.2 5 15.4 5 11V6l7-3z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path d="M9.5 12.2l1.8 1.8 3.4-3.8" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )
  }
  {
    name === "deny" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M8 8l8 8M16 8l-8 8" fill="none" stroke="currentColor" stroke-width="1.8" />
      </svg>
    )
  }
  {
    name === "evidence" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <path
          d="M7 3h7l4 4v14H7V3z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path d="M14 3v4h4M9 11h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )
  }
  {
    name === "verify" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M14.5 14.5L19 19" fill="none" stroke="currentColor" stroke-width="1.8" />
      </svg>
    )
  }
  {
    name === "identity" && (
      <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
        <circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M5.5 19c1.4-3 3.7-4.5 6.5-4.5S16.6 16 18 19" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    )
  }
</span>
