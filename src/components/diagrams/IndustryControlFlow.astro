---
import DiagramShell from "./DiagramShell.astro";

interface Props {
  industry: "healthcare" | "financial" | "automation";
  title?: string;
}

const { industry, title } = Astro.props;

const configs = {
  healthcare: {
    defaultTitle: "Healthcare governed AI transaction",
    caption:
      "Healthcare applications may invoke an AI provider only after Request Admission Authorization. The returned result is an untrusted proposal. Enterprise effect requires independent Result-to-Action Authorization of the declared intended action. The EHR remains authoritative.",
    application: "Healthcare Application",
    context:
      "Required trusted context (role, workflow, approved pathway, source trust, context tags)",
    provider: "AI Provider (after admission ALLOW)",
    result: "AI-Generated Result — untrusted proposal",
    action: "Declare Intended Enterprise Action",
    allowAction: "Application executes authorized action",
    denyAdmission: "Hard stop — no provider invocation",
    denyAction: "Hard stop — no enterprise effect",
    sor: "EHR / System of Record remains authoritative",
    note: "BeaconGuard authorizes; the healthcare application executes. Clinical judgment and the EHR are not replaced.",
    text: "Healthcare Application → Required trusted context → Optional System Connector → Request Admission Authorization. DENY → hard stop, no provider invocation. ALLOW → AI Provider → AI-Generated Result (untrusted proposal) → Declare Intended Enterprise Action → Result-to-Action Authorization. DENY → hard stop, no enterprise effect. ALLOW → application executes authorized action → EHR / System of Record remains authoritative.",
  },
  financial: {
    defaultTitle: "Financial governed AI transaction",
    caption:
      "AML, KYC, fraud, and dispute applications may invoke an AI provider only after Request Admission Authorization. Proposed recommendations and actions remain untrusted until Result-to-Action Authorization. Case and transaction systems remain authoritative.",
    application: "AML / KYC / Fraud / Dispute Application",
    context:
      "Required trusted context (analyst or service identity, case and transaction context, source trust, requested action)",
    provider: "AI Provider (after admission ALLOW)",
    result: "AI-Generated Result — untrusted proposal",
    action: "Declare Intended Enterprise Action",
    allowAction: "Application executes authorized action",
    denyAdmission: "Hard stop — no provider invocation",
    denyAction: "Hard stop — no enterprise effect",
    sor: "Case / transaction systems remain authoritative",
    note: "BeaconGuard authorizes use of a proposed result. It does not determine fraud, AML, credit, or legal outcomes.",
    text: "AML / KYC / Fraud / Dispute Application → Required trusted context → Optional System Connector → Request Admission Authorization. DENY → hard stop, no provider invocation. ALLOW → AI Provider → AI-Generated Result (untrusted proposal) → Declare Intended Enterprise Action → Result-to-Action Authorization. DENY → hard stop, no enterprise effect. ALLOW → application executes authorized action → case and transaction systems remain authoritative.",
  },
  automation: {
    defaultTitle: "Regulated automation governed AI transaction",
    caption:
      "Existing applications may invoke an AI provider only after Request Admission Authorization. Automation proposals remain untrusted until Result-to-Action Authorization of the declared intended action.",
    application: "Existing Application",
    context: "Required trusted context",
    provider: "AI Provider (after admission ALLOW)",
    result: "AI-Generated Result — untrusted proposal",
    action: "Declare Intended Enterprise Action",
    allowAction: "Application executes authorized action",
    denyAdmission: "Hard stop — no provider invocation",
    denyAction: "Hard stop — no enterprise effect",
    sor: "Production system of record remains authoritative",
    note: "Provider success is not enterprise authorization. BeaconGuard authorizes; the application executes.",
    text: "Existing Application → Required trusted context → Optional System Connector → Request Admission Authorization. DENY → hard stop, no provider invocation. ALLOW → AI Provider → AI-Generated Result (untrusted proposal) → Declare Intended Enterprise Action → Result-to-Action Authorization. DENY → hard stop, no enterprise effect. ALLOW → application executes authorized action → production system of record remains authoritative.",
  },
} as const;

const config = configs[industry];
const diagramTitle = title ?? config.defaultTitle;
---

<DiagramShell
  title={diagramTitle}
  caption={config.caption}
  className={`bg-diagram--industry bg-diagram--industry-${industry}`}
>
  <div class="bg-txn" role="list">
    <div class="bg-flow-step bg-txn-app" role="listitem">{config.application}</div>
    <div class="bg-flow-arrow" aria-hidden="true">↓</div>
    <div class="bg-flow-step" role="listitem">{config.context}</div>
    <div class="bg-flow-arrow" aria-hidden="true">↓</div>
    <div class="bg-flow-step bg-flow-step--optional" role="listitem">
      Optional System Connector
    </div>
    <div class="bg-flow-arrow" aria-hidden="true">↓</div>
    <div class="bg-flow-step bg-flow-step--boundary" role="listitem">
      Request Admission Authorization
    </div>

    <div class="bg-txn-fork" aria-label="Request admission outcomes">
      <div class="bg-txn-arm bg-txn-arm--deny">
        <div class="bg-flow-step bg-outcome-deny">
          <strong>DENY</strong>
          <span>{config.denyAdmission}</span>
        </div>
      </div>
      <div class="bg-txn-arm bg-txn-arm--allow">
        <div class="bg-flow-step bg-outcome-allow">
          <strong>ALLOW</strong>
          <span>Provider invocation permitted</span>
        </div>
        <div class="bg-flow-arrow" aria-hidden="true">↓</div>
        <div class="bg-flow-step bg-txn-provider" role="listitem">{config.provider}</div>
        <div class="bg-flow-arrow" aria-hidden="true">↓</div>
        <div class="bg-flow-step bg-txn-result" role="listitem">
          {config.result}
        </div>
        <div class="bg-flow-arrow" aria-hidden="true">↓</div>
        <div class="bg-flow-step" role="listitem">{config.action}</div>
        <div class="bg-flow-arrow" aria-hidden="true">↓</div>
        <div class="bg-flow-step bg-flow-step--boundary" role="listitem">
          Result-to-Action Authorization
        </div>
        <div class="bg-txn-fork bg-txn-fork--nested" aria-label="Action authorization outcomes">
          <div class="bg-txn-arm bg-txn-arm--deny">
            <div class="bg-flow-step bg-outcome-deny">
              <strong>DENY</strong>
              <span>{config.denyAction}</span>
            </div>
          </div>
          <div class="bg-txn-arm bg-txn-arm--allow">
            <div class="bg-flow-step bg-outcome-allow">
              <strong>ALLOW</strong>
              <span>{config.allowAction}</span>
            </div>
            <div class="bg-flow-arrow" aria-hidden="true">↓</div>
            <div class="bg-flow-step bg-txn-sor" role="listitem">{config.sor}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-flow-step bg-outcome-evidence bg-txn-evidence" role="listitem">
      <strong>Decision evidence</strong>
      <span>Inspectable through BeaconGuard Verify</span>
    </div>
  </div>

  <p class="bg-flow-note">{config.note}</p>

  <div slot="text">
    <p>{config.text}</p>
    <p>
      Result-to-Action Authorization means authorization of the declared
      intended enterprise action under the Active Verified Release. It does not
      mean semantic scoring of model content. Provider success is not enterprise
      authorization.
    </p>
  </div>
</DiagramShell>
