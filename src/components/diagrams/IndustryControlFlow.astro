---
interface Props { industry?: "healthcare" | "financial" | "automation"; title?: string; }
const { industry } = Astro.props;
---
<figure class="figma-diagram">
  <img
    class="figma-diagram-image"
    src="/diagrams/beaconguard-industry-action-flow.svg"
    alt="Healthcare and financial examples use the same BeaconGuard exact-action authorization model while governing different business consequences."
    loading="lazy"
    decoding="async"
  />
  <figcaption>One authorization model; different consequential business actions.</figcaption>
</figure>
<style>
  .figma-diagram { margin:1.5rem 0; }
  .figma-diagram-image { display:block; width:100%; height:auto; border-radius:1rem; }
  figcaption { margin-top:.7rem; color:var(--text-muted); font-size:.9rem; }
</style>
