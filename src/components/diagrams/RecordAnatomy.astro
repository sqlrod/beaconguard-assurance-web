---
import DiagramShell from "./DiagramShell.astro";

const groups = [
  {
    title: "Authorization result",
    fields: [
      "Decision scope (consequential action)",
      "ACTION ALLOW or ACTION DENY",
      "Reason / failed condition",
    ],
  },
  {
    title: "Exact-action identity",
    fields: [
      "Material action description / type",
      "Canonical action identity or digest",
      "Target resource / system context",
    ],
  },
  {
    title: "Actor and delegated authority",
    fields: [
      "Human / service / agent identity",
      "Delegation chain or authority context",
      "Tenant and environment binding",
    ],
  },
  {
    title: "Governing policy authority",
    fields: [
      "release_identity",
      "release / manifest integrity identity",
      "playbook / policy identity",
      "trust epoch or equivalent trust state",
    ],
  },
  {
    title: "Execution authority",
    fields: [
      "One-time grant identity when ALLOW",
      "Grant binding to material-action identity",
      "Consumption / reuse status",
    ],
  },
  {
    title: "Evidence integrity",
    fields: [
      "Evidence / correlation identity",
      "Integrity-verification information",
      "Reconstruction inputs and references",
    ],
  },
];
---

<DiagramShell
  title="Verifiable Decision Record anatomy"
  caption="Illustrative field groups showing the evidence needed to verify what action was authorized, under which authority, and with what execution binding. Not a normative public schema."
  className="bg-diagram--record-anatomy"
>
  <p class="bg-diagram-banner">
    Illustrative sample — field names and grouping are for reviewer orientation only.
  </p>

  <div class="bg-anatomy-grid" role="list">
    {
      groups.map((group) => (
        <section class="bg-anatomy-group" role="listitem">
          <h4 class="bg-anatomy-title">{group.title}</h4>
          <ul>
            {group.fields.map((field) => <li>{field}</li>)}
          </ul>
        </section>
      ))
    }
  </div>

  <div slot="text">
    <p>
      The evidence model distinguishes the action being authorized, the actor and
      delegated authority, the verified release allowed to govern the decision,
      one-time execution authority when ALLOW is issued, and integrity information
      required for verification and deterministic reconstruction.
    </p>
  </div>
</DiagramShell>
