---
import DiagramShell from "./DiagramShell.astro";

const groups = [
  {
    title: "Decision outcome and reason",
    fields: [
      "Decision outcome (ALLOW or DENY)",
      "Authorization point (request admission or result-to-action)",
      "Reason code / decision reason (illustrative)",
    ],
  },
  {
    title: "Governed transaction correlation",
    fields: [
      "Related request and action decision identifiers",
      "Request–result–action correlation context",
      "Provider interaction reference (when applicable)",
    ],
  },
  {
    title: "Declared action and enterprise effect",
    fields: [
      "Intended enterprise action (declared)",
      "AI-generated result status (untrusted proposal)",
      "Enterprise-effect outcome (authorized or prevented)",
    ],
  },
  {
    title: "Actor, tenant, environment, and workflow",
    fields: [
      "Actor type",
      "Tenant and environment context",
      "Workflow identity",
    ],
  },
  {
    title: "Active release and playbook identity",
    fields: ["release_identity", "playbook_identity"],
  },
  {
    title: "Trust, freshness, and replay results",
    fields: [
      "Authenticity / trust check results",
      "Freshness result",
      "Replay resistance result (where configured)",
    ],
  },
  {
    title: "Evidence identity and integrity",
    fields: [
      "Evidence / record identity",
      "Integrity-verification information",
      "Related source-evidence references",
    ],
  },
  {
    title: "Optional review obligation",
    fields: [
      "Review obligation (does not change permission)",
      "Governance notification context",
    ],
  },
];
---

<DiagramShell
  title="Verifiable Decision Record anatomy"
  caption="Illustrative field groups for related request-admission and result-to-action decisions. Not a normative public schema."
  className="bg-diagram--record-anatomy"
>
  <p class="bg-diagram-banner">
    Illustrative sample — field names and grouping are for reviewer orientation
    only, not a published public schema. Related request and action decisions
    share correlation context; each retains its own immutable outcome.
  </p>
  <div class="bg-anatomy-grid" role="list">
    {
      groups.map((group) => (
        <section class="bg-anatomy-group" role="listitem">
          <h4 class="bg-anatomy-title">{group.title}</h4>
          <ul>
            {group.fields.map((field) => (
              <li>{field}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <div slot="text">
    <p>
      Annotated groups: decision outcome and authorization point; governed
      transaction correlation across related request and action decisions;
      declared action and enterprise-effect outcome; actor, tenant, environment,
      and workflow context; active release and playbook identity; trust,
      freshness, and replay results; evidence identity and integrity; optional
      review obligation that does not change permission. Labelled illustrative —
      not a normative public schema.
    </p>
  </div>
</DiagramShell>
