---
import DiagramShell from "./DiagramShell.astro";
import OutcomeFork from "./OutcomeFork.astro";

const management = [
  "Compliance Playbook",
  "Validation and Compilation",
  "Governance Approval",
  "Signing",
  "Signed Immutable Release Artifact",
  "Controlled Distribution",
  "Release Verification and Activation",
  "Active Verified Release",
];

const runtime = [
  "Enterprise Application",
  "Optional System Connector",
  "Request Validation and Context Normalization",
  "Request Authenticity Verification",
  "Tenant and Environment Binding",
  "Freshness and Distributed Replay Checks",
  "Deterministic Compliance Playbook Evaluation",
  "Determine ALLOW or DENY",
  "Persist Verifiable Decision Record",
];

const dependencies = [
  "Customer identity provider",
  "Workforce identity",
  "Service and workload identity",
  "Shared replay authority",
  "Evidence provider",
  "Key and secret custody",
  "Operational monitoring",
];
---

<DiagramShell
  title="BeaconGuard architecture planes"
  caption="Management plane is outside the per-request path. Runtime data plane evaluates, persists evidence, then forks to ALLOW or DENY. Supporting trust dependencies reinforce the path without becoming alternate execution routes."
  className="bg-diagram--architecture"
>
  <div class="bg-planes bg-planes--architecture bg-planes--responsive">
    <section class="bg-plane" aria-labelledby="arch-mgmt-title">
      <h4 id="arch-mgmt-title" class="bg-plane-title">
        Management plane
        <span class="bg-plane-badge">Outside per-request path</span>
      </h4>
      <div class="bg-flow" role="list">
        {
          management.map((step, index) => (
            <>
              <div
                class:list={[
                  "bg-flow-step",
                  step === "Active Verified Release" && "bg-outcome-evidence",
                ]}
                role="listitem"
              >
                {step}
              </div>
              {index < management.length - 1 && (
                <div class="bg-flow-arrow" aria-hidden="true">
                  ↓
                </div>
              )}
            </>
          ))
        }
      </div>
      <p class="bg-flow-note">
        Active Verified Release feeds deterministic runtime evaluation.
      </p>
    </section>

    <section class="bg-plane" aria-labelledby="arch-runtime-title">
      <h4 id="arch-runtime-title" class="bg-plane-title">
        Runtime data plane
        <span class="bg-plane-badge">Evidence before forward</span>
      </h4>
      <div class="bg-flow" role="list">
        {
          runtime.map((step, index) => (
            <>
              <div
                class:list={[
                  "bg-flow-step",
                  step.includes("Determine ALLOW") && "bg-flow-step--decision",
                  step.includes("Persist") && "bg-outcome-evidence",
                  step.includes("System Connector") && "bg-flow-step--optional",
                ]}
                role="listitem"
              >
                {step.includes("Persist") ? (
                  <>
                    <strong>{step}</strong>
                    <span>Required before any downstream effect</span>
                  </>
                ) : (
                  step
                )}
              </div>
              {index < runtime.length - 1 && (
                <div class="bg-flow-arrow" aria-hidden="true">
                  ↓
                </div>
              )}
            </>
          ))
        }
      </div>

      <OutcomeFork
        allowLabel="Governed AI / API / Automated System"
        denyLabel="Hard Stop / No Downstream Execution"
      />
    </section>

    <section class="bg-plane" aria-labelledby="arch-deps-title">
      <h4 id="arch-deps-title" class="bg-plane-title">
        Supporting trust dependencies
        <span class="bg-plane-badge">Side list — not alternate paths</span>
      </h4>
      <ul class="bg-dep-list">
        {dependencies.map((item) => <li>{item}</li>)}
      </ul>
      <p class="bg-flow-note">
        The System Connector does not evaluate controls, activate releases, issue
        permission, or bypass enforcement. The Control Plane is not on the
        per-request execution path.
      </p>
    </section>
  </div>

  <div slot="text">
    <p>
      Management plane: Compliance Playbook → Validation and Compilation →
      Governance Approval → Signing → Signed Immutable Release Artifact →
      Controlled Distribution → Release Verification and Activation → Active
      Verified Release (feeds runtime).
    </p>
    <p>
      Runtime data plane: Enterprise Application → Optional System Connector →
      Request Validation and Context Normalization → Request Authenticity
      Verification → Tenant and Environment Binding → Freshness and Distributed
      Replay Checks → Deterministic Compliance Playbook Evaluation → Determine
      ALLOW or DENY → Persist Verifiable Decision Record → mutually exclusive
      fork. Branch ALLOW → governed AI, API, or automated system; Branch DENY →
      hard stop with no downstream execution.
    </p>
    <p>
      Supporting dependencies: Customer identity provider; Workforce identity;
      Service and workload identity; Shared replay authority; Evidence provider;
      Key and secret custody; Operational monitoring.
    </p>
  </div>
</DiagramShell>
