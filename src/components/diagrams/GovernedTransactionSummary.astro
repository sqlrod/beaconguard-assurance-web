---
/**
 * Compact executive transaction summary for homepage hero.
 * Not the full Orthographic Security Circuit.
 */
import DiagramIcon from "./primitives/DiagramIcon.astro";

interface Props {
  title?: string;
  idPrefix?: string;
}

const { title = "Governed transaction", idPrefix = "gts" } = Astro.props;
const mid = `${idPrefix}-m`;
---

<figure class="gts" aria-labelledby={`${idPrefix}-title`}>
  <h3 id={`${idPrefix}-title`} class="gts-title visually-hidden">{title}</h3>

  <div class="gts-desktop" aria-hidden="true">
    <svg class="gts-svg" viewBox="0 0 720 160" focusable="false">
      <defs>
        <marker id={`${mid}-n`} markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
          <path d="M0,0 L7,3 L0,6 Z" fill="var(--connector-neutral)"></path>
        </marker>
        <marker id={`${mid}-a`} markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
          <path d="M0,0 L7,3 L0,6 Z" fill="var(--connector-allow)"></path>
        </marker>
        <marker id={`${mid}-d`} markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
          <path d="M0,0 L7,3 L0,6 Z" fill="var(--connector-deny)"></path>
        </marker>
      </defs>
      <path class="gts-path gts-path--neutral" d="M118 70 H168" marker-end={`url(#${mid}-n)`}></path>
      <path class="gts-path gts-path--deny" d="M210 98 V130" marker-end={`url(#${mid}-d)`}></path>
      <path class="gts-path gts-path--allow" d="M252 70 H302" marker-end={`url(#${mid}-a)`}></path>
      <path class="gts-path gts-path--neutral" d="M386 70 H436" marker-end={`url(#${mid}-n)`}></path>
      <path class="gts-path gts-path--deny" d="M478 98 V130" marker-end={`url(#${mid}-d)`}></path>
      <path class="gts-path gts-path--allow" d="M520 70 H570" marker-end={`url(#${mid}-a)`}></path>
    </svg>

    <ol class="gts-nodes">
      <li class="gts-node">
        <span class="gts-role"><DiagramIcon name="app" /> REQUEST</span>
        <strong>Enterprise request</strong>
      </li>
      <li class="gts-node gts-node--gate">
        <span class="gts-role"><DiagramIcon name="shield" /> SHIELD 1</span>
        <strong>Request Admission</strong>
        <span class="gts-stop">DENY</span>
      </li>
      <li class="gts-node gts-node--provider">
        <span class="gts-role"><DiagramIcon name="provider" /> AI PROPOSAL</span>
        <strong>Untrusted result</strong>
      </li>
      <li class="gts-node gts-node--gate">
        <span class="gts-role"><DiagramIcon name="shield" /> SHIELD 2</span>
        <strong>Action Authorization</strong>
        <span class="gts-stop">DENY</span>
      </li>
      <li class="gts-node gts-node--action">
        <span class="gts-role"><DiagramIcon name="database" /> ACTION</span>
        <strong>Authorized effect</strong>
      </li>
    </ol>
  </div>

  <ol class="gts-mobile" aria-hidden="true">
    <li><strong>Request</strong> · Enterprise request</li>
    <li><strong>Request Admission</strong> · DENY stop</li>
    <li><strong>AI proposal</strong> · Untrusted</li>
    <li><strong>Action Authorization</strong> · DENY stop</li>
    <li><strong>Action</strong> · Authorized effect</li>
  </ol>

  <figcaption class="visually-hidden">
    Compact sequence: enterprise request through Request Admission, optional
    REQUEST DENY hard stop, untrusted AI proposal, Result-to-Action
    Authorization with optional ACTION DENY hard stop, then authorized
    enterprise effect.
  </figcaption>
</figure>
