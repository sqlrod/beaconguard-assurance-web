---
/**
 * Pass 01B-R3A1 — Control Fabric geometry correction.
 * Strict SVG grid; BeaconGuard authorizes; Enterprise Application executes.
 */
interface Props {
  title?: string;
  idPrefix?: string;
  compact?: boolean;
  forceDesktop?: boolean;
}

const {
  title = "BeaconGuard Control Fabric",
  idPrefix = "cf",
  compact = false,
  forceDesktop = false,
} = Astro.props;

const mid = `${idPrefix}-m`;
const labelledBy = `${idPrefix}-title`;

/** Desktop grid constants (SVG units) — keep in sync with validator expectations */
const G = {
  vbW: 1280,
  vbH: 680,
  col1: { x: 60, w: 270 },
  col2: { x: 430, w: 330 },
  col3: { x: 860, w: 350 },
  state: { x: 80, w: 230, h: 80, gap: 56 },
  prepareY: 148,
  receiveY: 284,
  executeY: 420,
  gate: { w: 180, h: 96 },
  gateX: 505,
  admissionY: 148,
  r2aY: 420,
  deny: { w: 180, h: 48 },
  denyReqY: 16,
  denyActY: 548,
  providerY: 148,
  providerH: 96,
  sorY: 420,
  sorH: 96,
  evidenceY: 616,
  boundY: 96,
  boundH: 430,
};
---

<figure
  class:list={[
    "psvg",
    "psvg-cf",
    compact && "psvg--compact",
    forceDesktop && "psvg--desktop",
  ]}
  data-diagram="control-fabric"
  data-cf-pass="r3a1"
  aria-labelledby={labelledBy}
>
  <h3 id={labelledBy} class="psvg-title">{title}</h3>

  <!-- ===================== DESKTOP 1280×680 — strict grid ===================== -->
  <svg
    class="psvg-desktop"
    viewBox={`0 0 ${G.vbW} ${G.vbH}`}
    preserveAspectRatio="xMidYMin meet"
    role="img"
    aria-hidden="true"
    focusable="false"
    data-grid="cf-desktop-r3a1"
  >
    <title>{title}</title>
    <desc>
      Strict-grid control fabric. Enterprise Application prepares a request through
      Request Admission. REQUEST DENY terminates. ALLOW reaches AI Provider. Untrusted
      result returns into Receive and Declare. Result-to-Action ALLOW returns into
      Enterprise Application Execute. ACTION DENY terminates. Execute sends authorized
      effect to System of Record. Evidence feeds read-only Verify outside runtime authority.
    </desc>
    <defs>
      <marker id={`${mid}-n`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-neutral)"></path>
      </marker>
      <marker id={`${mid}-a`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-allow)"></path>
      </marker>
      <marker id={`${mid}-d`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-deny)"></path>
      </marker>
      <marker id={`${mid}-e`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-evidence)"></path>
      </marker>
      <filter id={`${mid}-depth`} x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="6" stdDeviation="5" flood-color="#000" flood-opacity="0.32"></feDropShadow>
      </filter>
      <filter id={`${mid}-gate`} x="-10%" y="-10%" width="120%" height="120%">
        <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#000" flood-opacity="0.4"></feDropShadow>
      </filter>
      <linearGradient id={`${mid}-bg-fill`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="rgba(14, 32, 58, 0.55)"></stop>
        <stop offset="100%" stop-color="rgba(8, 18, 36, 0.72)"></stop>
      </linearGradient>
      <linearGradient id={`${mid}-gate-fill`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(18, 42, 72, 0.98)"></stop>
        <stop offset="100%" stop-color="rgba(8, 20, 40, 0.98)"></stop>
      </linearGradient>
    </defs>

    <!-- COL 2 — BeaconGuard (dominant surface) -->
    <g data-node-id="bg-boundary" data-collision-check="true" filter={`url(#${mid}-depth)`}>
      <rect
        x={G.col2.x}
        y={G.boundY}
        width={G.col2.w}
        height={G.boundH}
        rx="16"
        fill={`url(#${mid}-bg-fill)`}
        class="psvg-bound psvg-bound--runtime psvg-cf-bg"
      ></rect>
      <g transform={`translate(${G.col2.x + 16}, ${G.boundY + 10})`} fill="none" stroke="var(--diagram-boundary-runtime)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2l8 4v6c0 5.25-3.4 9.74-8 11-4.6-1.26-8-5.75-8-11V6l8-4z"></path>
      </g>
      <text x={G.col2.x + 48} y={G.boundY + 24} class="psvg-bound-label psvg-bound-label--runtime">BEACONGUARD</text>
      <text x={G.col2.x + 16} y={G.boundY + 42} class="psvg-cf-sublabel">AUTHORIZES — DOES NOT EXECUTE</text>
    </g>

    <!-- COL 1 — Enterprise Application (persistent participant) -->
    <g data-node-id="enterprise-app" data-collision-check="true">
      <rect
        x={G.col1.x}
        y={G.boundY}
        width={G.col1.w}
        height={G.boundH}
        rx="16"
        class="psvg-bound psvg-bound--enterprise"
      ></rect>
      <g transform={`translate(${G.col1.x + 14}, ${G.boundY + 10})`} fill="none" stroke="var(--diagram-boundary-enterprise)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="M2 8h20"></path>
      </g>
      <text x={G.col1.x + 44} y={G.boundY + 28} class="psvg-bound-label">ENTERPRISE APPLICATION</text>

      <g data-node-id="prepare" data-cf-role="app-state" data-collision-check="true">
        <rect x={G.state.x} y={G.prepareY} width={G.state.w} height={G.state.h} rx="12" class="psvg-node"></rect>
        <text x={G.state.x + 16} y={G.prepareY + 32} class="psvg-role">PREPARE REQUEST</text>
        <text x={G.state.x + 16} y={G.prepareY + 58} class="psvg-strong">Governed outbound request</text>
        <circle cx={G.state.x + G.state.w} cy={G.prepareY + G.state.h / 2} r="6" class="psvg-port" data-port="REQUEST OUT"></circle>
      </g>

      <g data-node-id="receive" data-cf-role="app-state" data-collision-check="true">
        <rect x={G.state.x} y={G.receiveY} width={G.state.w} height={G.state.h} rx="12" class="psvg-node"></rect>
        <text x={G.state.x + 16} y={G.receiveY + 28} class="psvg-role">RECEIVE + DECLARE</text>
        <text x={G.state.x + 16} y={G.receiveY + 52} class="psvg-strong">Untrusted result</text>
        <text x={G.state.x + 16} y={G.receiveY + 72} class="psvg-desc">Intended enterprise action</text>
        <circle cx={G.state.x} cy={G.receiveY + 36} r="6" class="psvg-port" data-port="RESULT IN"></circle>
        <circle cx={G.state.x + G.state.w} cy={G.receiveY + 60} r="6" class="psvg-port" data-port="ACTION OUT"></circle>
      </g>

      <g data-node-id="execute" data-cf-role="app-state" data-collision-check="true">
        <rect x={G.state.x} y={G.executeY} width={G.state.w} height={G.state.h} rx="12" class="psvg-node psvg-node--allow"></rect>
        <text x={G.state.x + 16} y={G.executeY + 32} class="psvg-role">EXECUTE</text>
        <text x={G.state.x + 16} y={G.executeY + 58} class="psvg-strong">Authorized action only</text>
        <circle cx={G.state.x} cy={G.executeY + G.state.h / 2} r="6" class="psvg-port" data-port="EXECUTION IN"></circle>
        <circle cx={G.state.x + G.state.w} cy={G.executeY + G.state.h / 2} r="6" class="psvg-port" data-port="SYSTEM EFFECT OUT"></circle>
      </g>
    </g>

    <!-- COL 3 — AI Provider (top lane, aligned with Request Admission) -->
    <g data-node-id="ai-provider" data-collision-check="true">
      <rect
        x={G.col3.x}
        y={G.providerY}
        width={G.col3.w}
        height={G.providerH}
        rx="14"
        class="psvg-bound psvg-bound--provider"
      ></rect>
      <g transform={`translate(${G.col3.x + 16}, ${G.providerY + 14})`} fill="none" stroke="var(--diagram-boundary-provider)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 16a6 6 0 0 0-11.2-3A5 5 0 0 0 7 22h11a4 4 0 0 0 0-8z"></path>
      </g>
      <text x={G.col3.x + 52} y={G.providerY + 32} class="psvg-bound-label psvg-bound-label--provider">AI PROVIDER</text>
      <text x={G.col3.x + 16} y={G.providerY + 56} class="psvg-cf-sublabel psvg-cf-sublabel--provider">UNTRUSTED EXTERNAL SERVICE</text>
      <text x={G.col3.x + 16} y={G.providerY + 86} class="psvg-strong">UNTRUSTED RESULT</text>
      <circle cx={G.col3.x} cy={G.providerY + G.providerH / 2} r="6" class="psvg-port" data-port="PROVIDER IN"></circle>
      <circle cx={G.col3.x + G.col3.w / 2} cy={G.providerY + G.providerH} r="6" class="psvg-port" data-port="PROVIDER OUT"></circle>
    </g>

    <!-- COL 3 — System of Record (bottom lane, aligned with Execute) -->
    <g data-node-id="sor" data-collision-check="true">
      <rect
        x={G.col3.x}
        y={G.sorY}
        width={G.col3.w}
        height={G.sorH}
        rx="14"
        class="psvg-bound psvg-bound--enterprise psvg-cf-sor"
      ></rect>
      <g transform={`translate(${G.col3.x + 16}, ${G.sorY + 14})`} fill="none" stroke="var(--diagram-boundary-enterprise)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="12" cy="5" rx="10" ry="3"></ellipse>
        <path d="M2 5v12c0 1.7 4.5 3 10 3s10-1.3 10-3V5"></path>
        <path d="M2 11c0 1.7 4.5 3 10 3s10-1.3 10-3"></path>
      </g>
      <text x={G.col3.x + 52} y={G.sorY + 32} class="psvg-bound-label">ENTERPRISE SYSTEM OF RECORD</text>
      <text x={G.col3.x + 16} y={G.sorY + 56} class="psvg-cf-sublabel">AUTHORITATIVE BUSINESS STATE</text>
      <text x={G.col3.x + 16} y={G.sorY + 86} class="psvg-desc">Application executes; SoR retains state</text>
      <circle cx={G.col3.x} cy={G.sorY + G.sorH / 2} r="6" class="psvg-port" data-port="SOR IN"></circle>
    </g>

    <!-- Request Admission gate (equal to Result-to-Action) -->
    <g data-node-id="request-admission" data-cf-role="auth-gate" data-collision-check="true" filter={`url(#${mid}-gate)`}>
      <rect x={G.gateX} y={G.admissionY} width={G.gate.w} height={G.gate.h} rx="10" fill={`url(#${mid}-gate-fill)`} class="psvg-cf-gate-shell"></rect>
      <rect x={G.gateX + 10} y={G.admissionY + 10} width={G.gate.w - 20} height={G.gate.h - 20} rx="6" class="psvg-gate psvg-cf-gate"></rect>
      <rect x={G.gateX + 10} y={G.admissionY + 46} width={G.gate.w - 20} height={32} class="psvg-cf-aperture"></rect>
      <path d={`M${G.gateX + 22} ${G.admissionY + 18} V${G.admissionY + G.gate.h - 18} M${G.gateX + G.gate.w - 22} ${G.admissionY + 18} V${G.admissionY + G.gate.h - 18}`} class="psvg-cf-rib"></path>
      <text x={G.gateX + G.gate.w / 2} y={G.admissionY + 34} class="psvg-cf-gate-title" text-anchor="middle">REQUEST ADMISSION</text>
      <text x={G.gateX + G.gate.w / 2} y={G.admissionY + 96} class="psvg-cf-gate-hint" text-anchor="middle">Authorization checkpoint</text>
    </g>

    <!-- Result-to-Action gate -->
    <g data-node-id="result-to-action" data-cf-role="auth-gate" data-collision-check="true" filter={`url(#${mid}-gate)`}>
      <rect x={G.gateX} y={G.r2aY} width={G.gate.w} height={G.gate.h} rx="10" fill={`url(#${mid}-gate-fill)`} class="psvg-cf-gate-shell"></rect>
      <rect x={G.gateX + 10} y={G.r2aY + 10} width={G.gate.w - 20} height={G.gate.h - 20} rx="6" class="psvg-gate psvg-cf-gate"></rect>
      <rect x={G.gateX + 10} y={G.r2aY + 46} width={G.gate.w - 20} height={32} class="psvg-cf-aperture"></rect>
      <path d={`M${G.gateX + 22} ${G.r2aY + 18} V${G.r2aY + G.gate.h - 18} M${G.gateX + G.gate.w - 22} ${G.r2aY + 18} V${G.r2aY + G.gate.h - 18}`} class="psvg-cf-rib"></path>
      <text x={G.gateX + G.gate.w / 2} y={G.r2aY + 34} class="psvg-cf-gate-title" text-anchor="middle">RESULT-TO-ACTION</text>
      <text x={G.gateX + G.gate.w / 2} y={G.r2aY + 96} class="psvg-cf-gate-hint" text-anchor="middle">Authorization checkpoint</text>
    </g>

    <!-- REQUEST DENY — above gate, cleared from transaction rails -->
    <path
      class="psvg-path psvg-path--deny"
      data-path-purpose="request-deny"
      d={`M${G.gateX + G.gate.w / 2} ${G.admissionY} V${G.denyReqY + G.deny.h}`}
      marker-end={`url(#${mid}-d)`}
    ></path>
    <g data-terminal="request-deny" data-cf-role="deny-terminal" data-collision-check="true">
      <rect x={G.gateX} y={G.denyReqY} width={G.deny.w} height={G.deny.h} rx="10" class="psvg-deny"></rect>
      <g transform={`translate(${G.gateX + 12}, ${G.denyReqY + 10})`}>
        <circle cx="12" cy="12" r="11" class="psvg-deny-x"></circle>
        <path d="M7 7 L17 17 M17 7 L7 17" class="psvg-deny-x-line"></path>
      </g>
      <text x={G.gateX + 42} y={G.denyReqY + 24} class="psvg-deny-strong">REQUEST DENY</text>
      <text x={G.gateX + 42} y={G.denyReqY + 44} class="psvg-deny-desc">No provider invocation</text>
    </g>

    <!-- ACTION DENY — below gate, cleared from ALLOW and SoR -->
    <path
      class="psvg-path psvg-path--deny"
      data-path-purpose="action-deny"
      d={`M${G.gateX + G.gate.w / 2} ${G.r2aY + G.gate.h} V${G.denyActY}`}
      marker-end={`url(#${mid}-d)`}
    ></path>
    <g data-terminal="action-deny" data-cf-role="deny-terminal" data-collision-check="true">
      <rect x={G.gateX} y={G.denyActY} width={G.deny.w} height={G.deny.h} rx="10" class="psvg-deny"></rect>
      <g transform={`translate(${G.gateX + 12}, ${G.denyActY + 10})`}>
        <circle cx="12" cy="12" r="11" class="psvg-deny-x"></circle>
        <path d="M7 7 L17 17 M17 7 L7 17" class="psvg-deny-x-line"></path>
      </g>
      <text x={G.gateX + 42} y={G.denyActY + 24} class="psvg-deny-strong">ACTION DENY</text>
      <text x={G.gateX + 42} y={G.denyActY + 44} class="psvg-deny-desc">No enterprise effect</text>
    </g>

    <!-- TOP RAIL: Prepare → Request Admission → ALLOW → AI Provider -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="request-out"
      d={`M${G.state.x + G.state.w} ${G.prepareY + G.state.h / 2} H${G.gateX}`}
      marker-end={`url(#${mid}-n)`}
    ></path>
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="request-allow"
      d={`M${G.gateX + G.gate.w} ${G.admissionY + 62} H${G.col3.x}`}
      marker-end={`url(#${mid}-a)`}
    ></path>
    <g data-label-plate="true">
      <rect x="720" y="168" width="72" height="22" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="756" y="184" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <!-- MIDDLE RETURN: AI Provider → RECEIVE + DECLARE (not into Result-to-Action) -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="provider-return"
      d={`M${G.col3.x + G.col3.w / 2} ${G.providerY + G.providerH} V280 H40 V${G.receiveY + 36} H${G.state.x}`}
      marker-end={`url(#${mid}-n)`}
    ></path>
    <g data-label-plate="true">
      <rect x="200" y="248" width="168" height="24" rx="4" class="psvg-plate"></rect>
      <text x="284" y="265" class="psvg-plate-text">UNTRUSTED RESULT</text>
    </g>

    <!-- BOTTOM RAIL: Receive → Result-to-Action → ALLOW returns into Execute (not SoR) -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="action-out"
      d={`M${G.state.x + G.state.w} ${G.receiveY + 60} H${G.gateX} V${G.r2aY + 62}`}
      marker-end={`url(#${mid}-n)`}
    ></path>
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="action-allow"
      d={`M${G.gateX + G.gate.w / 2} ${G.r2aY + 62} H${G.gateX} H${G.state.x}`}
      marker-end={`url(#${mid}-a)`}
    ></path>
    <g data-label-plate="true">
      <rect x="340" y={G.r2aY + 48} width="72" height="22" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="376" y={G.r2aY + 64} class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <!-- Execute → System of Record (routes below Result-to-Action; app executes) -->
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="system-effect"
      d={`M${G.state.x + G.state.w} ${G.executeY + G.state.h - 10} H${G.col1.x + G.col1.w + 36} V${G.r2aY + G.gate.h + 14} H${G.col3.x} V${G.sorY + G.sorH / 2}`}
      marker-end={`url(#${mid}-a)`}
    ></path>
    <g data-label-plate="true">
      <rect x="720" y={G.r2aY + G.gate.h + 2} width="120" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="780" y={G.r2aY + G.gate.h + 16} class="psvg-plate-text psvg-plate-text--allow">App executes</text>
    </g>

    <!-- Evidence lane (separate; no return to gates) -->
    <g data-node-id="evidence-spine">
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-from-admission"
        d={`M${G.gateX + G.gate.w + 8} ${G.admissionY + 62} H790 V${G.evidenceY + 24}`}
        marker-end={`url(#${mid}-e)`}
      ></path>
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-from-action"
        d={`M${G.gateX + G.gate.w + 8} ${G.r2aY + 62} H790 V${G.evidenceY + 24}`}
        marker-end={`url(#${mid}-e)`}
      ></path>
      <g data-node-id="decision-records" data-collision-check="true">
        <rect x="430" y={G.evidenceY} width="300" height="48" rx="10" class="psvg-evidence"></rect>
        <text x="448" y={G.evidenceY + 30} class="psvg-strong">VERIFIABLE DECISION RECORDS</text>
      </g>
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-to-verify"
        d={`M730 ${G.evidenceY + 24} H860`}
        marker-end={`url(#${mid}-e)`}
      ></path>
      <g data-node-id="verify" data-collision-check="true">
        <rect x="860" y={G.evidenceY} width="350" height="48" rx="10" class="psvg-bound psvg-bound--verify"></rect>
        <text x="878" y={G.evidenceY + 20} class="psvg-bound-label psvg-bound-label--verify">BEACONGUARD VERIFY — READ-ONLY</text>
        <text x="878" y={G.evidenceY + 38} class="psvg-desc">Outside runtime authority</text>
      </g>
    </g>
  </svg>

  <!-- ===================== COMPACT 440×1080 ===================== -->
  <svg
    class="psvg-compact"
    viewBox="0 0 440 1080"
    preserveAspectRatio="xMidYMin meet"
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <title>{title} — compact</title>
    <desc>
      Vertical control fabric. Persistent Enterprise Application prepares, receives,
      and executes. Dual DENY side terminals. Evidence rail to read-only Verify.
    </desc>
    <defs>
      <marker id={`${mid}-cn`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-neutral)"></path>
      </marker>
      <marker id={`${mid}-ca`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-allow)"></path>
      </marker>
      <marker id={`${mid}-cd`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-deny)"></path>
      </marker>
      <marker id={`${mid}-ce`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-evidence)"></path>
      </marker>
    </defs>

    <!-- Persistent Enterprise Application boundary -->
    <rect x="24" y="40" width="280" height="820" rx="16" class="psvg-bound psvg-bound--enterprise"></rect>
    <text x="40" y="68" class="psvg-bound-label">ENTERPRISE APPLICATION</text>

    <g data-node-id="c-prepare" data-cf-role="app-state" data-collision-check="true">
      <rect x="44" y="88" width="240" height="80" rx="12" class="psvg-node"></rect>
      <text x="60" y="118" class="psvg-role">PREPARE</text>
      <text x="60" y="144" class="psvg-strong">Governed request</text>
    </g>
    <path class="psvg-path psvg-path--neutral" data-path-purpose="c-to-admission" d="M164 168 V200" marker-end={`url(#${mid}-cn)`}></path>

    <g data-node-id="c-admission" data-cf-role="auth-gate" data-collision-check="true">
