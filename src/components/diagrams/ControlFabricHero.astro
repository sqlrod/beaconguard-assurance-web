---
/**
 * Pass 01B-R3A — BeaconGuard Control Fabric hero visual.
 * Pure inline SVG (desktop + compact). Art-direction candidate only.
 * Icons: Lucide-style paths (ISC license); inlined, no icon-package dependency.
 */
interface Props {
  title?: string;
  idPrefix?: string;
  compact?: boolean;
  forceDesktop?: boolean;
}

const {
  title = "BeaconGuard Control Fabric",
  idPrefix = "cf",
  compact = false,
  forceDesktop = false,
} = Astro.props;

const mid = `${idPrefix}-m`;
const labelledBy = `${idPrefix}-title`;
---

<figure
  class:list={[
    "psvg",
    "psvg-cf",
    compact && "psvg--compact",
    forceDesktop && "psvg--desktop",
  ]}
  data-diagram="control-fabric"
  aria-labelledby={labelledBy}
>
  <h3 id={labelledBy} class="psvg-title">{title}</h3>

  <!-- ===================== DESKTOP 1280×720 ===================== -->
  <svg
    class="psvg-desktop"
    viewBox="0 0 1280 720"
    preserveAspectRatio="xMidYMin meet"
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <title>{title}</title>
    <desc>
      Closed-loop control fabric. Enterprise Application prepares a request through
      Request Admission. REQUEST DENY terminates before provider invocation. ALLOW
      reaches AI Provider. Untrusted result returns to the same application. Declared
      action passes Result-to-Action. ACTION DENY terminates. ALLOW enters Execute,
      then System of Record. Both gates emit evidence to Verifiable Decision Records
      and read-only BeaconGuard Verify outside runtime authority.
    </desc>
    <defs>
      <marker id={`${mid}-n`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-neutral)"></path>
      </marker>
      <marker id={`${mid}-a`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-allow)"></path>
      </marker>
      <marker id={`${mid}-d`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-deny)"></path>
      </marker>
      <marker id={`${mid}-e`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-evidence)"></path>
      </marker>
      <filter id={`${mid}-depth`} x="-8%" y="-8%" width="116%" height="116%">
        <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#000" flood-opacity="0.35"></feDropShadow>
      </filter>
      <filter id={`${mid}-gate`} x="-10%" y="-10%" width="120%" height="120%">
        <feDropShadow dx="0" dy="10" stdDeviation="8" flood-color="#000" flood-opacity="0.45"></feDropShadow>
      </filter>
      <linearGradient id={`${mid}-bg-fill`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="rgba(14, 32, 58, 0.55)"></stop>
        <stop offset="100%" stop-color="rgba(8, 18, 36, 0.72)"></stop>
      </linearGradient>
      <linearGradient id={`${mid}-gate-fill`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(18, 42, 72, 0.98)"></stop>
        <stop offset="100%" stop-color="rgba(8, 20, 40, 0.98)"></stop>
      </linearGradient>
    </defs>

    <!-- BeaconGuard authorization boundary (dominant) -->
    <g data-node-id="bg-boundary" data-collision-check="true" filter={`url(#${mid}-depth)`}>
      <rect
        x="400"
        y="48"
        width="430"
        height="560"
        rx="18"
        fill={`url(#${mid}-bg-fill)`}
        class="psvg-bound psvg-bound--runtime psvg-cf-bg"
      ></rect>
      <!-- security icon -->
      <g transform="translate(420, 64)" fill="none" stroke="var(--diagram-boundary-runtime)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2l8 4v6c0 5.25-3.4 9.74-8 11-4.6-1.26-8-5.75-8-11V6l8-4z"></path>
      </g>
      <text x="452" y="78" class="psvg-bound-label psvg-bound-label--runtime">BEACONGUARD</text>
      <text x="452" y="98" class="psvg-cf-sublabel">INDEPENDENT AUTHORIZATION BOUNDARY</text>
    </g>

    <!-- Enterprise Application -->
    <g data-node-id="enterprise-app" data-collision-check="true">
      <rect x="48" y="88" width="302" height="512" rx="16" class="psvg-bound psvg-bound--enterprise"></rect>
      <g transform="translate(64, 104)" fill="none" stroke="var(--diagram-boundary-enterprise)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="M2 8h20"></path>
      </g>
      <text x="96" y="120" class="psvg-bound-label">ENTERPRISE APPLICATION</text>

      <g data-node-id="prepare" data-collision-check="true">
        <rect x="68" y="148" width="252" height="88" rx="12" class="psvg-node"></rect>
        <text x="84" y="178" class="psvg-role">PREPARE REQUEST</text>
        <text x="84" y="204" class="psvg-strong">Governed outbound request</text>
        <circle cx="320" cy="192" r="6" class="psvg-port" data-port="REQUEST OUT"></circle>
        <text x="236" y="178" class="psvg-port-label" text-anchor="end">REQUEST OUT</text>
      </g>

      <g data-node-id="receive" data-collision-check="true">
        <rect x="68" y="300" width="252" height="112" rx="12" class="psvg-node"></rect>
        <text x="84" y="330" class="psvg-role">RECEIVE + DECLARE</text>
        <text x="84" y="356" class="psvg-strong">Untrusted result</text>
        <text x="84" y="380" class="psvg-desc">Intended enterprise action</text>
        <circle cx="68" cy="348" r="6" class="psvg-port" data-port="RESULT IN"></circle>
        <text x="84" y="294" class="psvg-port-label">RESULT IN</text>
        <circle cx="320" cy="372" r="6" class="psvg-port" data-port="ACTION OUT"></circle>
        <text x="236" y="400" class="psvg-port-label" text-anchor="end">ACTION OUT</text>
      </g>

      <g data-node-id="execute" data-collision-check="true">
        <rect x="68" y="468" width="252" height="96" rx="12" class="psvg-node psvg-node--allow"></rect>
        <text x="84" y="500" class="psvg-role">EXECUTE</text>
        <text x="84" y="528" class="psvg-strong">Authorized action only</text>
        <circle cx="68" cy="508" r="6" class="psvg-port" data-port="EXECUTION IN"></circle>
        <text x="84" y="460" class="psvg-port-label">EXECUTION IN</text>
        <circle cx="320" cy="528" r="6" class="psvg-port" data-port="SYSTEM EFFECT OUT"></circle>
        <text x="200" y="548" class="psvg-port-label" text-anchor="end">SYSTEM EFFECT OUT</text>
      </g>
    </g>

    <!-- AI Provider -->
    <g data-node-id="ai-provider" data-collision-check="true">
      <rect x="900" y="100" width="320" height="168" rx="14" class="psvg-bound psvg-bound--provider"></rect>
      <g transform="translate(920, 118)" fill="none" stroke="var(--diagram-boundary-provider)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 16a6 6 0 0 0-11.2-3A5 5 0 0 0 7 22h11a4 4 0 0 0 0-8z"></path>
      </g>
      <text x="956" y="136" class="psvg-bound-label psvg-bound-label--provider">AI PROVIDER</text>
      <text x="920" y="164" class="psvg-cf-sublabel psvg-cf-sublabel--provider">UNTRUSTED EXTERNAL SERVICE</text>
      <text x="920" y="204" class="psvg-strong">Returned result</text>
      <text x="920" y="228" class="psvg-desc">Untrusted proposal</text>
      <circle cx="900" cy="192" r="6" class="psvg-port" data-port="PROVIDER IN"></circle>
      <circle cx="900" cy="236" r="6" class="psvg-port" data-port="PROVIDER OUT"></circle>
    </g>

    <!-- System of Record -->
    <g data-node-id="sor" data-collision-check="true">
      <rect x="900" y="390" width="320" height="152" rx="14" class="psvg-bound psvg-bound--enterprise psvg-cf-sor"></rect>
      <g transform="translate(920, 408)" fill="none" stroke="var(--diagram-boundary-enterprise)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="12" cy="5" rx="10" ry="3"></ellipse>
        <path d="M2 5v12c0 1.7 4.5 3 10 3s10-1.3 10-3V5"></path>
        <path d="M2 11c0 1.7 4.5 3 10 3s10-1.3 10-3"></path>
      </g>
      <text x="956" y="426" class="psvg-bound-label">ENTERPRISE SYSTEM OF RECORD</text>
      <text x="920" y="454" class="psvg-cf-sublabel">AUTHORITATIVE BUSINESS STATE</text>
      <text x="920" y="500" class="psvg-strong">Authorized enterprise effect</text>
      <circle cx="900" cy="500" r="6" class="psvg-port" data-port="SOR IN"></circle>
    </g>

    <!-- Request Admission chokepoint -->
    <g data-node-id="request-admission" data-collision-check="true" filter={`url(#${mid}-gate)`}>
      <rect x="512" y="112" width="156" height="168" rx="10" fill={`url(#${mid}-gate-fill)`} class="psvg-cf-gate-shell"></rect>
      <rect x="528" y="128" width="124" height="136" rx="6" class="psvg-gate psvg-cf-gate"></rect>
      <!-- aperture / controlled passage -->
      <rect x="528" y="176" width="124" height="40" class="psvg-cf-aperture"></rect>
      <path d="M536 136 V252 M644 136 V252" class="psvg-cf-rib"></path>
      <text x="590" y="156" class="psvg-cf-gate-title" text-anchor="middle">REQUEST</text>
      <text x="590" y="176" class="psvg-cf-gate-title" text-anchor="middle">ADMISSION</text>
      <text x="590" y="236" class="psvg-cf-gate-hint" text-anchor="middle">Authorization</text>
      <text x="590" y="252" class="psvg-cf-gate-hint" text-anchor="middle">checkpoint</text>
    </g>

    <!-- Result-to-Action chokepoint -->
    <g data-node-id="result-to-action" data-collision-check="true" filter={`url(#${mid}-gate)`}>
      <rect x="512" y="340" width="156" height="168" rx="10" fill={`url(#${mid}-gate-fill)`} class="psvg-cf-gate-shell"></rect>
      <rect x="528" y="356" width="124" height="136" rx="6" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="528" y="404" width="124" height="40" class="psvg-cf-aperture"></rect>
      <path d="M536 364 V480 M644 364 V480" class="psvg-cf-rib"></path>
      <text x="590" y="384" class="psvg-cf-gate-title" text-anchor="middle">RESULT-TO-</text>
      <text x="590" y="404" class="psvg-cf-gate-title" text-anchor="middle">ACTION</text>
      <text x="590" y="464" class="psvg-cf-gate-hint" text-anchor="middle">Authorization</text>
      <text x="590" y="480" class="psvg-cf-gate-hint" text-anchor="middle">checkpoint</text>
    </g>

    <!-- REQUEST RAIL -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="request-out"
      d="M320 192 H528"
      marker-end={`url(#${mid}-n)`}
    ></path>
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="request-allow"
      d="M652 196 H900"
      marker-end={`url(#${mid}-a)`}
    ></path>
    <g data-label-plate="true">
      <rect x="720" y="168" width="72" height="22" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="756" y="184" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <!-- REQUEST DENY terminal -->
    <path
      class="psvg-path psvg-path--deny"
      data-path-purpose="request-deny"
      d="M590 112 V72 H760"
      marker-end={`url(#${mid}-d)`}
    ></path>
    <g data-terminal="request-deny" data-collision-check="true">
      <rect x="760" y="40" width="200" height="64" rx="10" class="psvg-deny"></rect>
      <g transform="translate(776, 52)">
        <circle cx="12" cy="12" r="11" class="psvg-deny-x"></circle>
        <path d="M7 7 L17 17 M17 7 L7 17" class="psvg-deny-x-line"></path>
      </g>
      <text x="808" y="64" class="psvg-deny-strong">REQUEST DENY</text>
      <text x="808" y="86" class="psvg-deny-desc">No provider invocation</text>
    </g>

    <!-- PROVIDER RETURN RAIL (outside admission lane; clears both gates) -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="provider-return"
      d="M900 236 H848 V292 H40 V348 H68"
      marker-end={`url(#${mid}-n)`}
    ></path>
    <g data-label-plate="true">
      <rect x="96" y="264" width="168" height="24" rx="4" class="psvg-plate"></rect>
      <text x="180" y="281" class="psvg-plate-text">UNTRUSTED RESULT</text>
    </g>

    <!-- ACTION RAIL into Result-to-Action -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="action-out"
      d="M320 372 H528"
      marker-end={`url(#${mid}-n)`}
    ></path>

    <!-- ACTION DENY (below aperture; does not share evidence lane) -->
    <path
      class="psvg-path psvg-path--deny"
      data-path-purpose="action-deny"
      d="M590 444 V456 H760"
      marker-end={`url(#${mid}-d)`}
    ></path>
    <g data-terminal="action-deny" data-collision-check="true">
      <rect x="760" y="424" width="120" height="64" rx="10" class="psvg-deny"></rect>
      <g transform="translate(776, 436)">
        <circle cx="12" cy="12" r="11" class="psvg-deny-x"></circle>
        <path d="M7 7 L17 17 M17 7 L7 17" class="psvg-deny-x-line"></path>
      </g>
      <text x="808" y="448" class="psvg-deny-strong">ACTION DENY</text>
      <text x="776" y="472" class="psvg-deny-desc">No enterprise effect</text>
    </g>

    <!-- ACTION ALLOW crosses aperture, then returns into Execute → SoR -->
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="action-allow"
      d="M528 424 H652 H680 V508 H68"
      marker-end={`url(#${mid}-a)`}
    ></path>
    <g data-label-plate="true">
      <rect x="300" y="480" width="72" height="22" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="336" y="496" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="system-effect"
      d="M320 528 H900"
      marker-end={`url(#${mid}-a)`}
    ></path>

    <!-- Evidence spine (routes around gates; no return to runtime) -->
    <g data-node-id="evidence-spine">
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-from-admission"
        d="M668 196 H720 V620"
        marker-end={`url(#${mid}-e)`}
      ></path>
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-from-action"
        d="M668 404 H720 V620"
        marker-end={`url(#${mid}-e)`}
      ></path>
      <g data-node-id="decision-records" data-collision-check="true">
        <rect x="420" y="620" width="280" height="56" rx="10" class="psvg-evidence"></rect>
        <g transform="translate(436, 636)" fill="none" stroke="var(--decision-evidence)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <path d="M14 2v6h6"></path>
        </g>
        <text x="468" y="654" class="psvg-strong">Verifiable Decision Records</text>
      </g>
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-to-verify"
        d="M700 648 H860"
        marker-end={`url(#${mid}-e)`}
      ></path>
      <g data-node-id="verify" data-collision-check="true">
        <rect x="860" y="620" width="360" height="56" rx="10" class="psvg-bound psvg-bound--verify"></rect>
        <text x="880" y="644" class="psvg-bound-label psvg-bound-label--verify">BEACONGUARD VERIFY</text>
        <text x="1088" y="644" class="psvg-cf-sublabel psvg-cf-sublabel--verify">READ-ONLY</text>
        <text x="880" y="664" class="psvg-desc">Outside runtime authority</text>
      </g>
    </g>
  </svg>

  <!-- ===================== COMPACT 440×1040 ===================== -->
  <svg
    class="psvg-compact"
    viewBox="0 0 440 1040"
    preserveAspectRatio="xMidYMin meet"
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <title>{title} — compact</title>
    <desc>
      Vertical control fabric. Same enterprise application prepares, receives,
      declares, and executes. Dual DENY terminals. Evidence side rail to Verify.
    </desc>
    <defs>
      <marker id={`${mid}-cn`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-neutral)"></path>
      </marker>
      <marker id={`${mid}-ca`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-allow)"></path>
      </marker>
      <marker id={`${mid}-cd`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-deny)"></path>
      </marker>
      <marker id={`${mid}-ce`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-evidence)"></path>
      </marker>
    </defs>

    <!-- Shared enterprise identity rail (does not enclose provider or SoR) -->
    <path d="M28 64 V820" class="psvg-cf-app-spine"></path>
    <text x="40" y="44" class="psvg-bound-label">ENTERPRISE APPLICATION</text>

    <g data-node-id="c-prepare" data-collision-check="true">
      <rect x="40" y="64" width="248" height="72" rx="12" class="psvg-node psvg-cf-app-state"></rect>
      <text x="56" y="92" class="psvg-role">PREPARE</text>
      <text x="56" y="116" class="psvg-strong">Governed request</text>
    </g>
    <path class="psvg-path psvg-path--neutral" data-path-purpose="c-to-admission" d="M164 136 V168" marker-end={`url(#${mid}-cn)`}></path>

    <!-- Request Admission (BeaconGuard gate) -->
    <g data-node-id="c-admission" data-collision-check="true">
      <rect x="40" y="168" width="248" height="88" rx="8" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="40" y="200" width="248" height="28" class="psvg-cf-aperture"></rect>
      <text x="164" y="192" class="psvg-cf-gate-title" text-anchor="middle">REQUEST ADMISSION</text>
      <text x="164" y="236" class="psvg-cf-gate-hint" text-anchor="middle">Authorization checkpoint</text>
    </g>
    <path class="psvg-path psvg-path--deny" data-path-purpose="c-req-deny" d="M288 214 H320" marker-end={`url(#${mid}-cd)`}></path>
    <g data-terminal="c-request-deny" data-collision-check="true">
      <rect x="320" y="186" width="104" height="64" rx="10" class="psvg-deny"></rect>
      <text x="332" y="212" class="psvg-deny-strong">REQUEST</text>
      <text x="332" y="230" class="psvg-deny-strong">DENY</text>
    </g>
    <path class="psvg-path psvg-path--allow" data-path-purpose="c-req-allow" d="M164 256 V288" marker-end={`url(#${mid}-ca)`}></path>
    <g data-label-plate="true">
      <rect x="128" y="260" width="72" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="164" y="275" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <!-- AI Provider outside enterprise identity -->
    <g data-node-id="c-provider" data-collision-check="true">
      <rect x="40" y="288" width="248" height="80" rx="12" class="psvg-bound psvg-bound--provider"></rect>
      <text x="56" y="316" class="psvg-bound-label psvg-bound-label--provider">AI PROVIDER</text>
      <text x="56" y="344" class="psvg-desc">Untrusted external service</text>
    </g>
    <path class="psvg-path psvg-path--neutral" data-path-purpose="c-return" d="M164 368 V400" marker-end={`url(#${mid}-cn)`}></path>
    <g data-label-plate="true">
      <rect x="80" y="372" width="168" height="22" rx="4" class="psvg-plate"></rect>
      <text x="164" y="388" class="psvg-plate-text">Untrusted result returns</text>
    </g>

    <g data-node-id="c-receive" data-collision-check="true">
      <rect x="40" y="400" width="248" height="88" rx="12" class="psvg-node psvg-cf-app-state"></rect>
      <text x="56" y="428" class="psvg-role">RECEIVE + DECLARE</text>
      <text x="56" y="456" class="psvg-strong">Same application</text>
      <text x="56" y="476" class="psvg-desc">Intended action</text>
    </g>
    <path class="psvg-path psvg-path--neutral" data-path-purpose="c-to-r2a" d="M164 488 V520" marker-end={`url(#${mid}-cn)`}></path>

    <!-- Result-to-Action -->
    <g data-node-id="c-r2a" data-collision-check="true">
      <rect x="40" y="520" width="248" height="88" rx="8" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="40" y="552" width="248" height="28" class="psvg-cf-aperture"></rect>
      <text x="164" y="544" class="psvg-cf-gate-title" text-anchor="middle">RESULT-TO-ACTION</text>
      <text x="164" y="588" class="psvg-cf-gate-hint" text-anchor="middle">Authorization checkpoint</text>
    </g>
    <path class="psvg-path psvg-path--deny" data-path-purpose="c-act-deny" d="M288 566 H320" marker-end={`url(#${mid}-cd)`}></path>
    <g data-terminal="c-action-deny" data-collision-check="true">
      <rect x="320" y="538" width="104" height="64" rx="10" class="psvg-deny"></rect>
      <text x="332" y="564" class="psvg-deny-strong">ACTION</text>
      <text x="332" y="582" class="psvg-deny-strong">DENY</text>
    </g>
    <path class="psvg-path psvg-path--allow" data-path-purpose="c-act-allow" d="M164 608 V640" marker-end={`url(#${mid}-ca)`}></path>
    <g data-label-plate="true">
      <rect x="128" y="612" width="72" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="164" y="627" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <g data-node-id="c-execute" data-collision-check="true">
