---
/**
 * Pass 01B-R3A2 — Orthographic closed-loop Control Fabric.
 * Rebuilt from first principles. George-supplied code was not copied.
 * Server-rendered inline SVG only; all IDs use idPrefix.
 */
interface Props {
  title?: string;
  idPrefix?: string;
  compact?: boolean;
  forceDesktop?: boolean;
}

const {
  title = "BeaconGuard Control Fabric",
  idPrefix = "cf",
  compact = false,
  forceDesktop = false,
} = Astro.props;

const mid = `${idPrefix}-m`;
const labelledBy = `${idPrefix}-title`;
---

<figure
  class:list={[
    "psvg",
    "psvg-cf",
    "psvg-cf--r3a2",
    compact && "psvg--compact",
    forceDesktop && "psvg--desktop",
  ]}
  data-diagram="control-fabric"
  data-cf-pass="r3a2"
  aria-labelledby={labelledBy}
>
  <h3 id={labelledBy} class="psvg-title">{title}</h3>

  <!-- ===================== DESKTOP 1200×760 ===================== -->
  <svg
    class="psvg-desktop"
    viewBox="0 0 1200 760"
    preserveAspectRatio="xMidYMin meet"
    shape-rendering="geometricPrecision"
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <title>{title}</title>
    <desc>
      Orthographic closed-loop circuit. Enterprise Application prepares a request
      through Request Admission. REQUEST DENY terminates at a barrier. ALLOW reaches
      AI Provider. Untrusted result returns into Receive and Declare. Declared action
      enters Result-to-Action. ACTION DENY terminates at a barrier. ALLOW returns into
      Execute. Application executes to System of Record. Evidence feeds read-only Verify.
    </desc>
    <defs>
      <marker id={`${mid}-n`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-neutral)"></path>
      </marker>
      <marker id={`${mid}-a`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-allow)"></path>
      </marker>
      <marker id={`${mid}-d`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-deny)"></path>
      </marker>
      <marker id={`${mid}-e`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-evidence)"></path>
      </marker>
      <marker id={`${mid}-r`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--cf-return)"></path>
      </marker>
      <linearGradient id={`${mid}-spine`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="rgba(125, 211, 252, 0.18)"></stop>
        <stop offset="100%" stop-color="rgba(14, 32, 58, 0.12)"></stop>
      </linearGradient>
    </defs>

    <!-- Column 2: restrained BeaconGuard control spine (not a crowding box) -->
    <g data-node-id="bg-spine">
      <rect x="420" y="96" width="290" height="400" rx="20" fill={`url(#${mid}-spine)`} class="psvg-cf-spine"></rect>
      <text x="565" y="88" class="psvg-bound-label psvg-bound-label--runtime" text-anchor="middle">BEACONGUARD</text>
      <text x="565" y="108" class="psvg-cf-sublabel" text-anchor="middle">INDEPENDENT AUTHORIZATION</text>
    </g>

    <!-- Column 1: Enterprise Application -->
    <g data-node-id="enterprise-app" data-collision-check="true">
      <rect x="40" y="64" width="300" height="600" rx="16" class="psvg-bound psvg-bound--enterprise"></rect>
      <g transform="translate(56, 76)" fill="none" stroke="var(--diagram-boundary-enterprise)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="M2 8h20"></path>
      </g>
      <text x="88" y="92" class="psvg-bound-label">ENTERPRISE APPLICATION</text>
      <text x="56" y="112" class="psvg-cf-sublabel">CONTROLLED ENTERPRISE WORKFLOW</text>

      <g data-node-id="prepare" data-cf-role="app-state" data-collision-check="true">
        <rect x="72" y="120" width="236" height="88" rx="12" class="psvg-node"></rect>
        <text x="88" y="152" class="psvg-role" data-owner-node="prepare">PREPARE</text>
        <text x="88" y="178" class="psvg-strong" data-owner-node="prepare">Governed outbound request</text>
        <circle cx="308" cy="164" r="5" class="psvg-port" data-port="REQUEST OUT"></circle>
      </g>

      <g data-node-id="receive" data-cf-role="app-state" data-collision-check="true">
        <rect x="72" y="320" width="236" height="88" rx="12" class="psvg-node"></rect>
        <text x="88" y="348" class="psvg-role" data-owner-node="receive">RECEIVE + DECLARE</text>
        <text x="88" y="372" class="psvg-strong" data-owner-node="receive">Untrusted result</text>
        <text x="88" y="392" class="psvg-desc" data-owner-node="receive">Intended enterprise action</text>
        <circle cx="72" cy="352" r="5" class="psvg-port" data-port="RESULT IN"></circle>
        <circle cx="308" cy="372" r="5" class="psvg-port" data-port="ACTION OUT"></circle>
      </g>

      <g data-node-id="execute" data-cf-role="app-state" data-collision-check="true">
        <rect x="72" y="520" width="236" height="88" rx="12" class="psvg-node psvg-node--allow"></rect>
        <text x="88" y="552" class="psvg-role" data-owner-node="execute">EXECUTE</text>
        <text x="88" y="578" class="psvg-strong" data-owner-node="execute">Authorized action only</text>
        <circle cx="72" cy="564" r="5" class="psvg-port" data-port="EXECUTION IN"></circle>
        <circle cx="308" cy="564" r="5" class="psvg-port" data-port="SYSTEM EFFECT OUT"></circle>
      </g>
    </g>

    <!-- Column 2: Request Admission gate -->
    <g data-node-id="request-admission" data-cf-role="auth-gate" data-collision-check="true">
      <rect x="440" y="112" width="250" height="104" rx="10" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="440" y="148" width="250" height="32" class="psvg-cf-aperture"></rect>
      <line x1="456" y1="120" x2="456" y2="204" class="psvg-cf-rib"></line>
      <line x1="674" y1="120" x2="674" y2="204" class="psvg-cf-rib"></line>
      <g transform="translate(456, 122)" fill="none" stroke="var(--diagram-boundary-runtime)" stroke-width="1.5">
        <rect x="4" y="2" width="14" height="12" rx="2"></rect>
        <path d="M7 2 V0.5 a4 4 0 0 1 8 0 V2"></path>
      </g>
      <text x="565" y="138" class="psvg-cf-gate-title" text-anchor="middle" data-owner-node="request-admission">REQUEST ADMISSION</text>
      <text x="565" y="192" class="psvg-cf-gate-hint" text-anchor="middle" data-owner-node="request-admission">Authorization checkpoint</text>
      <circle cx="440" cy="164" r="5" class="psvg-port" data-port="ADMISSION IN"></circle>
      <circle cx="690" cy="164" r="5" class="psvg-port" data-port="ADMISSION OUT"></circle>
      <circle cx="670" cy="216" r="4" class="psvg-port psvg-port--evidence" data-port="ADMISSION EVIDENCE"></circle>
    </g>

    <!-- Column 2: Result-to-Action gate -->
    <g data-node-id="result-to-action" data-cf-role="auth-gate" data-collision-check="true">
      <rect x="440" y="336" width="250" height="104" rx="10" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="440" y="372" width="250" height="32" class="psvg-cf-aperture"></rect>
      <line x1="456" y1="344" x2="456" y2="428" class="psvg-cf-rib"></line>
      <line x1="674" y1="344" x2="674" y2="428" class="psvg-cf-rib"></line>
      <g transform="translate(456, 346)" fill="none" stroke="var(--diagram-boundary-runtime)" stroke-width="1.5">
        <rect x="4" y="2" width="14" height="12" rx="2"></rect>
        <path d="M7 2 V0.5 a4 4 0 0 1 8 0 V2"></path>
      </g>
      <text x="565" y="362" class="psvg-cf-gate-title" text-anchor="middle" data-owner-node="result-to-action">RESULT-TO-ACTION</text>
      <text x="565" y="416" class="psvg-cf-gate-hint" text-anchor="middle" data-owner-node="result-to-action">Authorization checkpoint</text>
      <circle cx="440" cy="388" r="5" class="psvg-port" data-port="ACTION IN"></circle>
      <circle cx="440" cy="420" r="5" class="psvg-port" data-port="ALLOW OUT"></circle>
      <circle cx="670" cy="440" r="4" class="psvg-port psvg-port--evidence" data-port="ACTION EVIDENCE"></circle>
    </g>

    <!-- Column 3: AI Provider (muted untrusted; not DENY crimson) -->
    <g data-node-id="ai-provider" data-collision-check="true">
      <rect x="840" y="112" width="300" height="144" rx="14" class="psvg-bound psvg-cf-provider"></rect>
      <g transform="translate(856, 128)" fill="none" stroke="var(--cf-provider-stroke)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 16a6 6 0 0 0-11.2-3A5 5 0 0 0 7 22h11a4 4 0 0 0 0-8z"></path>
      </g>
      <text x="892" y="146" class="psvg-bound-label psvg-cf-provider-label">AI PROVIDER</text>
      <text x="856" y="168" class="psvg-cf-sublabel">UNTRUSTED EXTERNAL SERVICE</text>
      <text x="856" y="200" class="psvg-strong">Returned result</text>
      <text x="856" y="222" class="psvg-desc">Untrusted proposal</text>
      <circle cx="840" cy="164" r="5" class="psvg-port" data-port="PROVIDER IN"></circle>
      <circle cx="990" cy="256" r="5" class="psvg-port" data-port="RESULT OUT"></circle>
    </g>

    <!-- Column 3: System of Record -->
    <g data-node-id="sor" data-collision-check="true">
      <rect x="840" y="520" width="300" height="104" rx="14" class="psvg-bound psvg-bound--enterprise psvg-cf-sor"></rect>
      <g transform="translate(856, 536)" fill="none" stroke="var(--diagram-boundary-enterprise)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <ellipse cx="12" cy="5" rx="10" ry="3"></ellipse>
        <path d="M2 5v12c0 1.7 4.5 3 10 3s10-1.3 10-3V5"></path>
        <path d="M2 11c0 1.7 4.5 3 10 3s10-1.3 10-3"></path>
      </g>
      <text x="892" y="554" class="psvg-bound-label">ENTERPRISE SYSTEM OF RECORD</text>
      <text x="856" y="578" class="psvg-cf-sublabel">AUTHORITATIVE BUSINESS STATE</text>
      <text x="856" y="602" class="psvg-desc">Application executes; SoR retains state</text>
      <circle cx="840" cy="564" r="5" class="psvg-port" data-port="SOR IN"></circle>
    </g>

    <!-- REQUEST DENY — barrier terminal (not a decision card) -->
    <g data-terminal="request-deny" data-barrier="true" data-collision-check="true">
      <path
        class="psvg-path psvg-path--deny"
        data-path-purpose="request-deny"
        d="M565 112 V72"
        marker-end={`url(#${mid}-d)`}
      ></path>
      <line x1="510" y1="56" x2="620" y2="56" class="psvg-cf-barrier" data-barrier="request-deny"></line>
      <g transform="translate(554, 36)">
        <circle cx="11" cy="11" r="10" class="psvg-deny-x"></circle>
        <path d="M6 6 L16 16 M16 6 L6 16" class="psvg-deny-x-line"></path>
      </g>
      <text x="630" y="48" class="psvg-deny-strong">REQUEST DENY</text>
      <text x="630" y="68" class="psvg-deny-desc">No provider invocation</text>
    </g>

    <!-- ACTION DENY — barrier terminal in dedicated pocket (not on ALLOW lane) -->
    <g data-terminal="action-deny" data-barrier="true" data-collision-check="true">
      <path
        class="psvg-path psvg-path--deny"
        data-path-purpose="action-deny"
        d="M565 440 V468"
        marker-end={`url(#${mid}-d)`}
      ></path>
      <line x1="510" y1="480" x2="620" y2="480" class="psvg-cf-barrier" data-barrier="action-deny"></line>
      <g transform="translate(554, 488)">
        <circle cx="11" cy="11" r="10" class="psvg-deny-x"></circle>
        <path d="M6 6 L16 16 M16 6 L6 16" class="psvg-deny-x-line"></path>
      </g>
      <text x="630" y="496" class="psvg-deny-strong">ACTION DENY</text>
      <text x="630" y="516" class="psvg-deny-desc">No enterprise effect</text>
    </g>

    <!-- Request rail: Prepare → Admission → ALLOW → Provider -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="request-out"
      d="M308 164 H440"
      marker-end={`url(#${mid}-n)`}
      vector-effect="non-scaling-stroke"
    ></path>
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="request-allow"
      d="M690 164 H840"
      marker-end={`url(#${mid}-a)`}
      vector-effect="non-scaling-stroke"
    ></path>
    <g data-label-plate="true">
      <rect x="740" y="140" width="64" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="772" y="155" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <!-- Provider return: lane y=284 via app/gate gap (clears evidence verticals) -->
    <path
      class="psvg-path psvg-path--return"
      data-path-purpose="provider-return"
      d="M990 256 V284 H380 V352 H72"
      marker-end={`url(#${mid}-r)`}
      vector-effect="non-scaling-stroke"
    ></path>
    <g data-label-plate="true">
      <rect x="200" y="260" width="152" height="20" rx="4" class="psvg-plate psvg-plate--return"></rect>
      <text x="276" y="275" class="psvg-plate-text psvg-plate-text--return">UNTRUSTED RESULT</text>
    </g>

    <!-- Declared action into Result-to-Action -->
    <path
      class="psvg-path psvg-path--neutral"
      data-path-purpose="action-out"
      d="M308 372 H440"
      marker-end={`url(#${mid}-n)`}
      vector-effect="non-scaling-stroke"
    ></path>
    <g data-label-plate="true">
      <rect x="318" y="384" width="120" height="18" rx="4" class="psvg-plate"></rect>
      <text x="378" y="397" class="psvg-plate-text">DECLARED ACTION</text>
    </g>

    <!-- ALLOW return lane y=564 into EXECUTION IN → Execute -->
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="action-allow"
      d="M440 420 V564 H72"
      marker-end={`url(#${mid}-a)`}
      vector-effect="non-scaling-stroke"
    ></path>
    <g data-label-plate="true">
      <rect x="280" y="540" width="64" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="312" y="555" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <!-- Application executes → SoR -->
    <path
      class="psvg-path psvg-path--allow"
      data-path-purpose="system-effect"
      d="M308 564 H840"
      marker-end={`url(#${mid}-a)`}
      vector-effect="non-scaling-stroke"
    ></path>
    <g data-label-plate="true">
      <rect x="560" y="572" width="148" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="634" y="587" class="psvg-plate-text psvg-plate-text--allow">APPLICATION EXECUTES</text>
    </g>

    <!-- Evidence rail -->
    <g data-node-id="evidence-rail">
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-from-admission"
        d="M670 216 V680 H520"
        marker-end={`url(#${mid}-e)`}
      ></path>
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-from-action"
        d="M670 440 V640 H790 V680"
        marker-end={`url(#${mid}-e)`}
      ></path>
      <line x1="390" y1="680" x2="1140" y2="680" class="psvg-cf-evidence-bus"></line>
      <g data-node-id="decision-records" data-collision-check="true">
        <rect x="390" y="688" width="280" height="40" rx="8" class="psvg-evidence"></rect>
        <text x="406" y="714" class="psvg-strong">VERIFIABLE DECISION RECORDS</text>
      </g>
      <path
        class="psvg-path psvg-path--evidence"
        data-path-purpose="evidence-to-verify"
        d="M670 708 H780"
        marker-end={`url(#${mid}-e)`}
      ></path>
      <g data-node-id="verify" data-collision-check="true">
        <rect x="780" y="688" width="360" height="40" rx="8" class="psvg-bound psvg-bound--verify"></rect>
        <text x="796" y="706" class="psvg-bound-label psvg-bound-label--verify">BEACONGUARD VERIFY</text>
        <text x="1020" y="706" class="psvg-cf-sublabel psvg-cf-sublabel--verify">READ-ONLY</text>
        <text x="796" y="722" class="psvg-desc">Outside runtime authority</text>
      </g>
    </g>
  </svg>

  <!-- ===================== COMPACT 440×1140 ===================== -->
  <svg
    class="psvg-compact"
    viewBox="0 0 440 1140"
    preserveAspectRatio="xMidYMin meet"
    shape-rendering="geometricPrecision"
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <title>{title} — compact</title>
    <desc>
      Compact orthographic circuit. Persistent Enterprise Application prepare,
      receive, and execute. DENY barrier terminals in side gutters. Evidence rail separate.
    </desc>
    <defs>
      <marker id={`${mid}-cn`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-neutral)"></path>
      </marker>
      <marker id={`${mid}-ca`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-allow)"></path>
      </marker>
      <marker id={`${mid}-cd`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-deny)"></path>
      </marker>
      <marker id={`${mid}-ce`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--connector-evidence)"></path>
      </marker>
      <marker id={`${mid}-cr`} markerWidth="10" markerHeight="10" refX="9" refY="4" orient="auto">
        <path d="M0,0 L9,4 L0,8 Z" fill="var(--cf-return)"></path>
      </marker>
    </defs>

    <rect x="24" y="48" width="280" height="900" rx="16" class="psvg-bound psvg-bound--enterprise"></rect>
    <text x="40" y="76" class="psvg-bound-label">ENTERPRISE APPLICATION</text>
    <text x="40" y="96" class="psvg-cf-sublabel">CONTROLLED ENTERPRISE WORKFLOW</text>

    <g data-node-id="c-prepare" data-cf-role="app-state" data-collision-check="true">
      <rect x="44" y="112" width="240" height="80" rx="12" class="psvg-node"></rect>
      <text x="60" y="142" class="psvg-role">PREPARE</text>
      <text x="60" y="168" class="psvg-strong">Governed request</text>
    </g>
    <path class="psvg-path psvg-path--neutral" data-path-purpose="c-to-admission" d="M164 192 V224" marker-end={`url(#${mid}-cn)`}></path>

    <g data-node-id="c-admission" data-cf-role="auth-gate" data-collision-check="true">
      <rect x="52" y="224" width="224" height="88" rx="8" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="52" y="256" width="224" height="28" class="psvg-cf-aperture"></rect>
      <text x="164" y="248" class="psvg-cf-gate-title" text-anchor="middle">REQUEST ADMISSION</text>
      <text x="164" y="292" class="psvg-cf-gate-hint" text-anchor="middle">Authorization checkpoint</text>
    </g>
    <!-- REQUEST DENY side gutter -->
    <path class="psvg-path psvg-path--deny" data-path-purpose="c-req-deny" d="M276 268 H308" marker-end={`url(#${mid}-cd)`}></path>
    <g data-terminal="c-request-deny" data-barrier="true" data-collision-check="true">
      <line x1="316" y1="248" x2="316" y2="288" class="psvg-cf-barrier"></line>
      <text x="328" y="264" class="psvg-deny-strong">REQUEST</text>
      <text x="328" y="282" class="psvg-deny-strong">DENY</text>
    </g>
    <path class="psvg-path psvg-path--allow" data-path-purpose="c-req-allow" d="M164 312 V344" marker-end={`url(#${mid}-ca)`}></path>
    <g data-label-plate="true">
      <rect x="128" y="316" width="72" height="20" rx="4" class="psvg-plate psvg-plate--allow"></rect>
      <text x="164" y="331" class="psvg-plate-text psvg-plate-text--allow">ALLOW</text>
    </g>

    <g data-node-id="c-provider" data-collision-check="true">
      <rect x="44" y="344" width="240" height="80" rx="12" class="psvg-bound psvg-cf-provider"></rect>
      <text x="60" y="372" class="psvg-bound-label psvg-cf-provider-label">AI PROVIDER</text>
      <text x="60" y="398" class="psvg-desc">Untrusted external service</text>
    </g>
    <path class="psvg-path psvg-path--return" data-path-purpose="c-return" d="M164 424 V456" marker-end={`url(#${mid}-cr)`}></path>
    <g data-label-plate="true">
      <rect x="80" y="428" width="168" height="20" rx="4" class="psvg-plate psvg-plate--return"></rect>
      <text x="164" y="443" class="psvg-plate-text psvg-plate-text--return">UNTRUSTED RESULT</text>
    </g>

    <g data-node-id="c-receive" data-cf-role="app-state" data-collision-check="true">
      <rect x="44" y="456" width="240" height="88" rx="12" class="psvg-node"></rect>
      <text x="60" y="484" class="psvg-role">RECEIVE + DECLARE</text>
      <text x="60" y="508" class="psvg-strong">Same application</text>
      <text x="60" y="528" class="psvg-desc">Intended action</text>
    </g>
    <path class="psvg-path psvg-path--neutral" data-path-purpose="c-to-r2a" d="M164 544 V576" marker-end={`url(#${mid}-cn)`}></path>

    <g data-node-id="c-r2a" data-cf-role="auth-gate" data-collision-check="true">
      <rect x="52" y="576" width="224" height="88" rx="8" class="psvg-gate psvg-cf-gate"></rect>
      <rect x="52" y="608" width="224" height="28" class="psvg-cf-aperture"></rect>
      <text x="164" y="600" class="psvg-cf-gate-title" text-anchor="middle">RESULT-TO-ACTION</text>
      <text x="164" y="644" class="psvg-cf-gate-hint" text-anchor="middle">Authorization checkpoint</text>
    </g>
