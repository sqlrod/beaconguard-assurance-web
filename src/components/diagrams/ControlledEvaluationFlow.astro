---
import DiagramShell from "./DiagramShell.astro";

const inputs = [
  "One bounded workflow",
  "Request contract",
  "Identity and trust context",
  "Tenant and environment assumptions",
  "Compliance controls",
  "Evidence requirements",
  "Deployment assumptions",
  "Recovery expectations",
];

const activities = [
  "Boundary placement",
  "Connector fit",
  "Identity mapping",
  "Playbook mapping",
  "ALLOW and DENY case design",
  "Replay and failure analysis",
  "Evidence review",
  "Deployment and recovery review",
  "Responsibility review",
];

const outputs = [
  "Architecture-fit memo",
  "Responsibility matrix",
  "Trust-boundary map",
  "Playbook mapping",
  "Sample decision records",
  "Deployment qualification assessment",
  "Recovery considerations",
  "Blocker register",
];
---

<DiagramShell
  title="Controlled Evaluation workflow"
  caption="A bounded architecture review: inputs, activities, and outputs. Not product deployment, certification, or production authorization."
  className="bg-diagram--controlled-eval"
>
  <div class="bg-diagram-columns" role="list">
    <section class="bg-diagram-column" role="listitem" aria-labelledby="ce-inputs">
      <h4 id="ce-inputs" class="bg-diagram-column-title">Inputs</h4>
      <ul>
        {inputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="ce-activities"
    >
      <h4 id="ce-activities" class="bg-diagram-column-title">Activities</h4>
      <ul>
        {activities.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="ce-outputs"
    >
      <h4 id="ce-outputs" class="bg-diagram-column-title">Outputs</h4>
      <ul>
        {outputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>

  <div slot="text">
    <p>
      Controlled Evaluation is a bounded review of one regulated workflow. It
      maps boundary placement, identity and trust, Compliance Playbook controls,
      ALLOW and DENY cases, evidence, and deployment-fit assumptions. It is not
      product deployment, certification, or production authorization.
    </p>
  </div>
</DiagramShell>
