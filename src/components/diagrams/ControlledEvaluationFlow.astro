---
import DiagramShell from "./DiagramShell.astro";

const inputs = [
  "One bounded consequential workflow",
  "Actor / agent identity and delegation model",
  "MCP / A2A / API / application invocation path",
  "Material-action contract",
  "Customer policy / approval authority",
  "Evidence requirements",
  "Deployment and executor assumptions",
];

const activities = [
  "Request-admission vs action-authorization mapping",
  "Identity and delegation mapping",
  "Exact-action binding design",
  "Verified-release / policy-authority mapping",
  "ACTION ALLOW and ACTION DENY cases",
  "One-time execution-grant validation",
  "Replay / mismatch / reuse failure analysis",
  "Evidence and reconstruction review",
  "Deployment-responsibility review",
];

const outputs = [
  "Architecture-fit memo",
  "Responsibility matrix",
  "Authority / trust-boundary map",
  "Material-action contract",
  "Policy / Playbook mapping",
  "Action decision case set",
  "Illustrative decision evidence",
  "Deployment assessment",
  "Blocker and residual-risk register",
];
---

<DiagramShell
  title="Controlled Evaluation workflow"
  caption="A bounded evaluation of one consequential AI workflow. It validates the finished-product architecture without implying customer-production deployment or certification."
  className="bg-diagram--controlled-eval"
>
  <div class="bg-diagram-columns" role="list">
    <section class="bg-diagram-column" role="listitem" aria-labelledby="ce-inputs">
      <h4 id="ce-inputs" class="bg-diagram-column-title">Inputs</h4>
      <ul>
        {inputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="ce-activities"
    >
      <h4 id="ce-activities" class="bg-diagram-column-title">Activities</h4>
      <ul>
        {activities.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="ce-outputs"
    >
      <h4 id="ce-outputs" class="bg-diagram-column-title">Outputs</h4>
      <ul>
        {outputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>
</DiagramShell>
