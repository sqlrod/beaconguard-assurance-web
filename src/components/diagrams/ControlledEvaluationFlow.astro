---
import DiagramShell from "./DiagramShell.astro";

const inputs = [
  "Representative outbound request",
  "Representative provider response",
  "Intended enterprise action",
  "Request–result–action correlation",
  "Identity and tenant context",
  "Active Verified Release",
  "Request ALLOW and DENY cases",
  "Result ALLOW and DENY cases",
  "Evidence, reconstruction, replay",
  "Report and export requirements",
  "Deployment boundaries",
  "Failure handling and non-AI fallback",
];

const activities = [
  "Dual-boundary placement",
  "Request admission case design",
  "Result-to-action case design",
  "Correlation and identity mapping",
  "Playbook and release fit",
  "Evidence and Verify review",
  "Reconstruction and replay review",
  "Export and report provenance",
  "Deployment and failure analysis",
  "Responsibility and residual-risk review",
];

const outputs = [
  "Governed Transaction Architecture Memo",
  "Control Boundary Findings",
  "Evidence and Verification Findings",
  "Pilot Qualification Findings",
  "Residual Risks",
  "Unsupported Claims",
];
---

<DiagramShell
  title="Controlled Evaluation workflow"
  caption="A bounded architecture review of one governed AI transaction: dual authorization inputs, evaluation activities, and qualification outputs. Not product deployment, certification, or production authorization."
  className="bg-diagram--controlled-eval"
>
  <div class="bg-diagram-columns" role="list">
    <section class="bg-diagram-column" role="listitem" aria-labelledby="ce-inputs">
      <h4 id="ce-inputs" class="bg-diagram-column-title">Inputs</h4>
      <ul>
        {inputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="ce-activities"
    >
      <h4 id="ce-activities" class="bg-diagram-column-title">Activities</h4>
      <ul>
        {activities.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="ce-outputs"
    >
      <h4 id="ce-outputs" class="bg-diagram-column-title">Outputs</h4>
      <ul>
        {outputs.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>

  <div slot="text">
    <p>
      Controlled Evaluation reviews one regulated AI transaction across Request
      Admission Authorization and Result-to-Action Authorization, plus Verify
      evidence requirements and deployment-fit assumptions. Outputs include a
      Governed Transaction Architecture Memo, Control Boundary Findings,
      Evidence and Verification Findings, Pilot Qualification Findings,
      Residual Risks, and Unsupported Claims. It is not product deployment,
      certification, or production authorization.
    </p>
  </div>
</DiagramShell>
