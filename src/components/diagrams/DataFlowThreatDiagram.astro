---
import DiagramShell from "./DiagramShell.astro";

const steps = [
  {
    n: 1,
    zone: "customer",
    text: "Enterprise application creates governed request",
  },
  {
    n: 2,
    zone: "customer",
    text: "Identity and tenant context enter BeaconGuard",
  },
  {
    n: 3,
    zone: "authorize",
    text: "Request is normalized",
  },
  {
    n: 4,
    zone: "authorize",
    text: "Request admission is evaluated (ALLOW or DENY)",
  },
  {
    n: 5,
    zone: "evidence",
    text: "Request decision evidence is recorded",
  },
  {
    n: 6,
    zone: "provider",
    text: "Authorized request reaches the AI provider",
  },
  {
    n: 7,
    zone: "provider",
    text: "Provider returns an AI-generated result",
  },
  {
    n: 8,
    zone: "authorize",
    text: "Result is bound to the governed transaction context",
  },
  {
    n: 9,
    zone: "authorize",
    text: "Intended enterprise action is declared and normalized",
  },
  {
    n: 10,
    zone: "authorize",
    text: "Result-to-action authorization is evaluated (ALLOW or DENY)",
  },
  {
    n: 11,
    zone: "evidence",
    text: "Result decision evidence is recorded",
  },
  {
    n: 12,
    zone: "enterprise",
    text: "Enterprise action is allowed or hard-stopped",
  },
  {
    n: 13,
    zone: "verify",
    text: "Canonical evidence enters the verification path",
  },
  {
    n: 14,
    zone: "verify",
    text: "Reviewer accesses Decision Explorer",
  },
  {
    n: 15,
    zone: "verify",
    text: "Reconstruction traces source evidence",
  },
  {
    n: 16,
    zone: "verify",
    text: "Replay verifies the recorded decision",
  },
  {
    n: 17,
    zone: "verify",
    text: "Export produces verification material",
  },
  {
    n: 18,
    zone: "insights",
    text: "AI-assisted insight remains outside authority",
  },
];

const zoneLabels: Record<string, string> = {
  customer: "Customer-controlled",
  authorize: "BeaconGuard Authorize",
  evidence: "Evidence path",
  provider: "AI provider trust boundary",
  enterprise: "Enterprise effect / system of record",
  verify: "BeaconGuard Verify (read-only)",
  insights: "Non-authoritative side path",
};
---

<DiagramShell
  title="Data-flow and trust boundaries"
  caption="Eighteen-step governed AI transaction across customer, Authorize, AI provider, enterprise system of record, evidence, and Verify trust boundaries. DENY hard-stops at request admission or result-to-action. Insights stay outside authority."
  className="bg-diagram--dfd"
>
  <div
    class="bg-dfd-flow"
    role="img"
    aria-label="Eighteen-step data-flow diagram with trust boundaries"
  >
    <section class="bg-dfd-zone" aria-label="Customer-controlled boundary">
      <h4 class="bg-dfd-zone-title">Customer-controlled boundary</h4>
      <div class="bg-flow-step">Enterprise Application</div>
      <div class="bg-flow-step bg-flow-step--optional">
        Optional System Connector
        <span class="bg-flow-step-detail">Non-evaluating</span>
      </div>
      <div class="bg-flow-step">Customer Identity Provider</div>
      <p class="bg-flow-note">
        IdP supplies identity context; it does not decide ALLOW or DENY.
      </p>
    </section>

    <section
      class="bg-dfd-zone bg-dfd-zone--runtime"
      aria-label="BeaconGuard Authorize boundary"
    >
      <h4 class="bg-dfd-zone-title">BeaconGuard Authorize boundary</h4>
      <div class="bg-flow-step bg-flow-step--boundary">
        Request Admission Authorization
      </div>
      <div class="bg-flow-step bg-outcome-evidence">
        Request Verifiable Decision Record
      </div>
      <div class="bg-txn-fork" aria-label="Request admission outcomes">
        <div class="bg-txn-arm bg-txn-arm--deny">
          <div class="bg-flow-step bg-outcome-deny">
            <strong>DENY</strong>
            <span>Hard stop · no provider invocation</span>
          </div>
        </div>
        <div class="bg-txn-arm bg-txn-arm--allow">
          <div class="bg-flow-step bg-outcome-allow">
            <strong>ALLOW</strong>
            <span>May invoke AI provider</span>
          </div>
        </div>
      </div>
    </section>

    <section
      class="bg-dfd-zone bg-dfd-zone--governed"
      aria-label="AI provider trust boundary"
    >
      <h4 class="bg-dfd-zone-title">AI provider trust boundary</h4>
      <div class="bg-flow-step bg-txn-provider">AI Provider</div>
      <div class="bg-flow-step bg-txn-result">
        AI-Generated Result
        <span class="bg-flow-step-detail">Untrusted proposal</span>
      </div>
      <p class="bg-flow-note">
        Provider success is not enterprise authorization.
      </p>
    </section>

    <section
      class="bg-dfd-zone bg-dfd-zone--runtime"
      aria-label="Result-to-action authorization"
    >
      <h4 class="bg-dfd-zone-title">Result-to-action authorization</h4>
      <div class="bg-flow-step">
        Bind result · declare Intended Enterprise Action
      </div>
      <div class="bg-flow-step bg-flow-step--boundary">
        Result-to-Action Authorization
      </div>
      <div class="bg-flow-step bg-outcome-evidence">
        Action Verifiable Decision Record
      </div>
      <div class="bg-txn-fork" aria-label="Action authorization outcomes">
        <div class="bg-txn-arm bg-txn-arm--deny">
          <div class="bg-flow-step bg-outcome-deny">
            <strong>DENY</strong>
            <span>Hard stop · no enterprise effect</span>
          </div>
        </div>
        <div class="bg-txn-arm bg-txn-arm--allow">
          <div class="bg-flow-step bg-outcome-allow">
            <strong>ALLOW</strong>
            <span>Application may execute authorized action</span>
          </div>
        </div>
      </div>
    </section>

    <section
      class="bg-dfd-zone bg-dfd-zone--governed"
      aria-label="Enterprise system of record boundary"
    >
      <h4 class="bg-dfd-zone-title">Enterprise system of record</h4>
      <div class="bg-flow-step bg-txn-sor">
        Enterprise Application executes · System of Record remains authoritative
      </div>
    </section>

    <section
      class="bg-dfd-zone bg-dfd-zone--evidence"
      aria-label="Evidence and Verify"
    >
      <h4 class="bg-dfd-zone-title">
        Evidence → BeaconGuard Verify (read-only functional domain)
      </h4>
      <div class="bg-flow-step bg-outcome-evidence">
        Canonical Verifiable Decision Records
      </div>
      <div class="bg-flow-step bg-flow-step--boundary">BeaconGuard Verify</div>
      <div class="bg-verify-grid" role="list">
        <div class="bg-flow-step" role="listitem">Decision Explorer</div>
        <div class="bg-flow-step" role="listitem">Reconstruction</div>
        <div class="bg-flow-step" role="listitem">Replay Verification</div>
        <div class="bg-flow-step" role="listitem">Verifiable Export</div>
      </div>
      <div class="bg-flow-step bg-verify-insights">
        AI-Assisted Insights
        <span>Outside trusted path · non-authoritative</span>
      </div>
    </section>

    <section
      class="bg-dfd-zone bg-dfd-zone--mgmt"
      aria-label="Management boundary"
    >
      <h4 class="bg-dfd-zone-title">
        Govern / management (outside request path)
      </h4>
      <div class="bg-flow-step">Control Plane · Compliance Playbook lifecycle</div>
      <div class="bg-flow-step bg-outcome-evidence">
        Active Verified Release (feeds Authorize)
      </div>
    </section>

    <ol class="bg-dfd-numbered-list">
      {
        steps.map((step) => (
          <li>
            <span class="bg-dfd-step-num">{step.n}.</span>
            <span class="bg-dfd-step-zone">{zoneLabels[step.zone]}</span>
            {step.text}
          </li>
        ))
      }
    </ol>
  </div>

  <div slot="text">
    <ol>
      {
        steps.map((step) => (
          <li>
            {step.text} ({zoneLabels[step.zone]})
          </li>
        ))
      }
    </ol>
  </div>
</DiagramShell>
