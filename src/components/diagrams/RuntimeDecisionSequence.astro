---
/**
 * Technical subflow for Request Admission Authorization only.
 * Not the complete governed AI transaction — see GovernedAITransaction.
 */
import DiagramShell from "./DiagramShell.astro";
import OutcomeFork from "./OutcomeFork.astro";

const stages = [
  {
    step: "STEP 1",
    title: "Request",
    description: "Enterprise application submits governed request context",
    className: "",
  },
  {
    step: "STEP 2",
    title: "Validate",
    description: "Required structure, normalization, required context",
    className: "",
  },
  {
    step: "STEP 3",
    title: "Verify",
    description:
      "Request authenticity; identity; tenant/environment binding; freshness; replay resistance; Active Verified Release",
    className: "",
  },
  {
    step: "STEP 4",
    title: "Evaluate",
    description: "Deterministic Compliance Playbook evaluation",
    className: "",
  },
  {
    step: "STEP 5",
    title: "Enforce",
    description: "Request Admission decision calculated as ALLOW or DENY",
    className: "bg-flow-step--decision",
  },
  {
    step: "STEP 6",
    title: "Record",
    description: "Verifiable Decision Record persisted",
    className: "bg-outcome-evidence",
  },
];
---

<DiagramShell
  title="Request admission technical subflow"
  caption="Admission-only path. ALLOW permits provider invocation for this request — it is not enterprise-action authorization. AI results remain untrusted proposals until Result-to-Action Authorization."
  className="bg-diagram--runtime-sequence"
>
  <div class="bg-flow" role="list">
    {
      stages.map((stage, index) => (
        <>
          <div
            class:list={["bg-flow-step", stage.className]}
            role="listitem"
          >
            <span class="diagram-step-number">{stage.step}</span>
            <strong class="diagram-step-title">{stage.title}</strong>
            <span class="diagram-step-description">{stage.description}</span>
          </div>
          {index < stages.length - 1 && (
            <div class="bg-flow-arrow" aria-hidden="true">
              ↓
            </div>
          )}
        </>
      ))
    }
  </div>

  <OutcomeFork
    allowLabel="AI provider invocation permitted for this request"
    denyLabel="Hard stop · no provider invocation"
    forkLabel="Mutually exclusive Request Admission outcomes after evidence persistence"
  />

  <div slot="text">
    <p>
      Request → Validate → Verify → Evaluate → Enforce → Record. ALLOW may
      invoke the AI provider for this governed request. DENY hard-stops with no
      provider invocation. This subflow does not authorize enterprise effect from
      an AI-generated result.
    </p>
  </div>
</DiagramShell>
