---
import DiagramShell from "./DiagramShell.astro";

const customer = [
  "Identity provider",
  "Network controls",
  "Host hardening",
  "Secrets and key custody",
  "Evidence-provider configuration",
  "Monitoring and incident response",
  "Clinical, legal, and business judgment",
];

const shared = [
  "Identity and tenant mapping",
  "Request and action context",
  "Environment separation",
  "Correlation requirements",
  "Retention design",
  "Recovery procedures",
  "Operational acceptance",
];

const beacon = [
  "Active Verified Release verification",
  "Request Admission Authorization",
  "Result-to-Action Authorization",
  "Binary ALLOW or DENY enforcement",
  "Verifiable Decision Records",
  "Fail-closed behavior where configured",
  "Verify read-only investigation surface",
];
---

<DiagramShell
  title="Trust and shared responsibility map"
  caption="Customer-controlled deployment, shared integration, and BeaconGuard authorization and Verify domains. AI-assisted insights are non-authoritative. Certification and legal compliance status remain separate."
  className="bg-diagram--trust-map"
>
  <div class="bg-diagram-columns" role="list">
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="trust-customer"
    >
      <h4 id="trust-customer" class="bg-diagram-column-title">
        Customer-Controlled
      </h4>
      <ul>
        {customer.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column"
      role="listitem"
      aria-labelledby="trust-shared"
    >
      <h4 id="trust-shared" class="bg-diagram-column-title">
        Shared Integration Boundary
      </h4>
      <ul>
        {shared.map((item) => <li>{item}</li>)}
      </ul>
    </section>
    <section
      class="bg-diagram-column bg-diagram-column--accent"
      role="listitem"
      aria-labelledby="trust-beacon"
    >
      <h4 id="trust-beacon" class="bg-diagram-column-title">
        BeaconGuard-Controlled
      </h4>
      <ul>
        {beacon.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>

  <div slot="text">
    <p>
      <strong>Customer-Controlled:</strong> Identity provider; network controls;
      host hardening; secrets and key custody; evidence-provider configuration;
      monitoring and incident response; clinical, legal, and business judgment.
    </p>
    <p>
      <strong>Shared Integration Boundary:</strong> Identity and tenant mapping;
      request and action context; environment separation; correlation
      requirements; retention design; recovery procedures; operational
      acceptance.
    </p>
    <p>
      <strong>BeaconGuard-Controlled:</strong> Active Verified Release
      verification; Request Admission Authorization; Result-to-Action
      Authorization; binary ALLOW or DENY; Verifiable Decision Records;
      fail-closed behavior where configured; Verify as a read-only investigation
      surface. AI-assisted insights remain non-authoritative and outside the
      trusted reconstruction path.
    </p>
  </div>
</DiagramShell>
