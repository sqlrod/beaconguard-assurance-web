---
/**
 * Orthographic Security Circuit — transaction authorization view.
 * Production-candidate reusable diagram (no staging review headings).
 */
import DiagramIcon from "../primitives/DiagramIcon.astro";

interface Props {
  title?: string;
  ariaLabel?: string;
  variant?: "detailed" | "compact";
  compact?: boolean;
  showEvidence?: boolean;
  idPrefix?: string;
}

const {
  title = "Governed AI transaction circuit",
  ariaLabel,
  variant = "detailed",
  compact = false,
  showEvidence = true,
  idPrefix = "osc",
} = Astro.props;

const isCompact = compact || variant === "compact";
const mid = `${idPrefix}-m`;
const labelledBy = `${idPrefix}-title`;
---

<figure
  class:list={["osc", isCompact && "osc--compact"]}
  data-diagram-direction="A"
  aria-labelledby={labelledBy}
  aria-label={ariaLabel}
>
  <h3 id={labelledBy} class="osc-title">{title}</h3>

  {/* Desktop / landscape circuit */}
  <div class="osc-desktop" aria-hidden="true">
    <svg class="osc-svg" viewBox="0 0 1200 680" focusable="false">
      <defs>
        <marker id={`${mid}-n`} markerWidth="9" markerHeight="9" refX="8" refY="3.5" orient="auto">
          <path d="M0,0 L8,3.5 L0,7 Z" fill="var(--connector-neutral)"></path>
        </marker>
        <marker id={`${mid}-a`} markerWidth="9" markerHeight="9" refX="8" refY="3.5" orient="auto">
          <path d="M0,0 L8,3.5 L0,7 Z" fill="var(--connector-allow)"></path>
        </marker>
        <marker id={`${mid}-d`} markerWidth="9" markerHeight="9" refX="8" refY="3.5" orient="auto">
          <path d="M0,0 L8,3.5 L0,7 Z" fill="var(--connector-deny)"></path>
        </marker>
        <marker id={`${mid}-e`} markerWidth="9" markerHeight="9" refX="8" refY="3.5" orient="auto">
          <path d="M0,0 L8,3.5 L0,7 Z" fill="var(--connector-evidence)"></path>
        </marker>
      </defs>

      <!-- Runtime boundary around both gates -->
      <rect
        class="osc-runtime-frame"
        x="420"
        y="48"
        width="280"
        height="420"
        rx="16"
      ></rect>

      <!-- Primary transaction paths -->
      <path class="osc-path osc-path--neutral" d="M300 120 H460" marker-end={`url(#${mid}-n)`}></path>
      <path class="osc-path osc-path--allow" d="M640 120 H820" marker-end={`url(#${mid}-a)`}></path>
      <path class="osc-path osc-path--deny" d="M560 168 V250" marker-end={`url(#${mid}-d)`}></path>

      <!-- Provider return lane into RESULT IN -->
      <path
        class="osc-path osc-path--neutral osc-path--return"
        d="M920 168 H980 V320 H220 V360"
        marker-end={`url(#${mid}-n)`}
      ></path>

      <path class="osc-path osc-path--neutral" d="M300 400 H460" marker-end={`url(#${mid}-n)`}></path>
      <path class="osc-path osc-path--deny" d="M560 448 V530" marker-end={`url(#${mid}-d)`}></path>
      <path class="osc-path osc-path--allow" d="M460 420 H360 V500" marker-end={`url(#${mid}-a)`}></path>
      <path class="osc-path osc-path--allow" d="M300 540 H820" marker-end={`url(#${mid}-a)`}></path>

      {
        showEvidence && (
          <>
            <path class="osc-path osc-path--evidence" d="M560 280 V600" marker-end={`url(#${mid}-e)`}></path>
            <path class="osc-path osc-path--evidence" d="M560 560 V600" marker-end={`url(#${mid}-e)`}></path>
            <path class="osc-path osc-path--evidence" d="M640 620 H820" marker-end={`url(#${mid}-e)`}></path>
          </>
        )
      }

      <!-- Path labels with plates -->
      <g class="osc-label-plate">
        <rect x="330" y="96" width="88" height="20" rx="4"></rect>
        <text x="374" y="110">Outbound</text>
      </g>
      <g class="osc-label-plate osc-label-plate--allow">
        <rect x="700" y="96" width="64" height="20" rx="4"></rect>
        <text x="732" y="110">Invoke</text>
      </g>
      <g class="osc-label-plate">
        <rect x="760" y="286" width="180" height="20" rx="4"></rect>
        <text x="850" y="300">Return into application</text>
      </g>
      <g class="osc-label-plate">
        <rect x="320" y="376" width="110" height="20" rx="4"></rect>
        <text x="375" y="390">Declared action</text>
      </g>
      <g class="osc-label-plate osc-label-plate--allow">
        <rect x="372" y="456" width="108" height="20" rx="4"></rect>
        <text x="426" y="470">ALLOW → execute</text>
      </g>
      <g class="osc-label-plate osc-label-plate--allow">
        <rect x="500" y="516" width="120" height="20" rx="4"></rect>
        <text x="560" y="530">Authorized effect</text>
      </g>
    </svg>

    <div class="osc-nodes">
      <div class="osc-app">
        <p class="osc-boundary"><DiagramIcon name="app" /> ENTERPRISE CONTROLLED BOUNDARY</p>
        <div class="osc-state" data-state="prepare">
          <span class="osc-role">PREPARE</span>
          <strong>Governed request</strong>
          <span class="osc-port osc-port--out" title="REQUEST OUT">REQUEST OUT</span>
        </div>
        <div class="osc-state" data-state="receive">
          <span class="osc-role">RECEIVE + DECLARE</span>
          <strong>Untrusted result</strong>
          <span class="osc-desc">Declared action</span>
          <span class="osc-port osc-port--in" title="RESULT IN">RESULT IN</span>
          <span class="osc-port osc-port--out" title="ACTION OUT">ACTION OUT</span>
        </div>
        <div class="osc-state" data-state="execute">
          <span class="osc-role">EXECUTE</span>
          <strong>Authorized action only</strong>
          <span class="osc-port osc-port--in" title="EXECUTION IN">EXECUTION IN</span>
          <span class="osc-port osc-port--out" title="SYSTEM EFFECT OUT">SYSTEM EFFECT OUT</span>
        </div>
      </div>

      <p class="osc-runtime-label">BEACONGUARD RUNTIME AUTHORIZATION BOUNDARY</p>

      <div class="osc-gate" data-gate="request">
        <span class="osc-role"><DiagramIcon name="shield" /> REQUEST ADMISSION</span>
        <strong>Authorization checkpoint</strong>
      </div>

      <div class="osc-terminal osc-terminal--deny" data-terminal="request-deny">
        <DiagramIcon name="deny" />
        <div>
          <strong>REQUEST DENY</strong>
          <span>No provider invocation</span>
        </div>
      </div>

      <div class="osc-provider">
        <p class="osc-boundary osc-boundary--provider">AI PROVIDER — UNTRUSTED EXTERNAL BOUNDARY</p>
        <span class="osc-role"><DiagramIcon name="provider" /> AI PROVIDER</span>
        <strong>Untrusted external service</strong>
      </div>

      <div class="osc-gate" data-gate="action">
        <span class="osc-role"><DiagramIcon name="shield" /> RESULT-TO-ACTION</span>
        <strong>Authorization checkpoint</strong>
      </div>

      <div class="osc-terminal osc-terminal--deny" data-terminal="action-deny">
        <DiagramIcon name="deny" />
        <div>
          <strong>ACTION DENY</strong>
          <span>No enterprise effect</span>
        </div>
      </div>

      <div class="osc-sor">
        <p class="osc-boundary">ENTERPRISE SYSTEM-OF-RECORD BOUNDARY</p>
        <span class="osc-role"><DiagramIcon name="database" /> ENTERPRISE SYSTEM OF RECORD</span>
        <strong>Authoritative business state</strong>
      </div>

      {
        showEvidence && (
          <div class="osc-evidence">
            <div class="osc-evidence-bus">
              <span class="osc-role"><DiagramIcon name="evidence" /> EVIDENCE BUS</span>
              <strong>Verifiable Decision Records</strong>
            </div>
            <div class="osc-verify">
              <p class="osc-boundary osc-boundary--verify">READ-ONLY VERIFICATION BOUNDARY</p>
              <span class="osc-role"><DiagramIcon name="verify" /> BEACONGUARD VERIFY</span>
              <strong>Read-only</strong>
            </div>
          </div>
        )
      }
    </div>
  </div>

  {/* Mobile vertical transaction spine — preserves geometry */}
  <div class="osc-mobile" aria-hidden="true">
    <div class="osc-mobile-app">
      <p class="osc-boundary"><DiagramIcon name="app" /> ENTERPRISE APPLICATION</p>
      <div class="osc-mobile-step">
        <span class="osc-role">PREPARE</span>
        <strong>Governed request</strong>
      </div>
    </div>
    <div class="osc-mobile-arrow" aria-hidden="true">↓ Outbound</div>
    <div class="osc-mobile-row">
      <div class="osc-gate osc-gate--mobile">
        <span class="osc-role"><DiagramIcon name="shield" /> Request Admission</span>
      </div>
      <div class="osc-terminal osc-terminal--deny">
        <DiagramIcon name="deny" />
        <div>
          <strong>REQUEST DENY</strong>
          <span>No provider invocation</span>
        </div>
      </div>
    </div>
    <div class="osc-mobile-arrow osc-mobile-arrow--allow" aria-hidden="true">↓ ALLOW · Invoke</div>
    <div class="osc-provider osc-provider--mobile">
      <span class="osc-role"><DiagramIcon name="provider" /> AI Provider</span>
      <strong>Untrusted external</strong>
    </div>
    <div class="osc-mobile-arrow" aria-hidden="true">↓ Return to same Enterprise Application</div>
    <div class="osc-mobile-app">
      <div class="osc-mobile-step">
        <span class="osc-role">RECEIVE + DECLARE</span>
        <strong>Untrusted result</strong>
        <span class="osc-desc">Declared action</span>
      </div>
    </div>
    <div class="osc-mobile-arrow" aria-hidden="true">↓ Declared action</div>
    <div class="osc-mobile-row">
      <div class="osc-gate osc-gate--mobile">
        <span class="osc-role"><DiagramIcon name="shield" /> Result-to-Action</span>
      </div>
      <div class="osc-terminal osc-terminal--deny">
        <DiagramIcon name="deny" />
        <div>
          <strong>ACTION DENY</strong>
          <span>No enterprise effect</span>
        </div>
      </div>
    </div>
    <div class="osc-mobile-arrow osc-mobile-arrow--allow" aria-hidden="true">↓ ALLOW → Execute</div>
    <div class="osc-mobile-app">
      <div class="osc-mobile-step">
        <span class="osc-role">EXECUTE</span>
        <strong>Authorized action only</strong>
      </div>
    </div>
    <div class="osc-mobile-arrow osc-mobile-arrow--allow" aria-hidden="true">↓ Authorized effect</div>
    <div class="osc-sor osc-sor--mobile">
      <span class="osc-role"><DiagramIcon name="database" /> System of Record</span>
      <strong>Authoritative business state</strong>
    </div>
    {
      showEvidence && (
        <div class="osc-evidence osc-evidence--mobile">
          <span class="osc-role"><DiagramIcon name="evidence" /> Evidence rail</span>
          <strong>Verifiable Decision Records → Verify (read-only)</strong>
        </div>
      )
    }
  </div>

  <figcaption class="visually-hidden">
    Prepare exits the Enterprise Application through Request Out into Request
    Admission. REQUEST DENY terminates with no provider invocation. ALLOW invokes
    the AI Provider. The provider result returns through Result In into Receive
    and Declare inside the same Enterprise Application. Declared action exits
    through Action Out into Result-to-Action. ACTION DENY terminates with no
    enterprise effect. ALLOW returns through Execution In into Execute, then
    System Effect Out into the Enterprise System of Record. Evidence from both
    gates joins a separate Verifiable Decision Records bus to BeaconGuard Verify
    outside runtime authority.
  </figcaption>
</figure>
