---
import DiagramShell from "./DiagramShell.astro";
import OutcomeFork from "./OutcomeFork.astro";

const management = [
  "Control Plane",
  "Compliance Playbook lifecycle",
  "Signing",
  "Distribution",
  "Verification and Activation",
  "Active Verified Release",
];

const runtime = [
  "Enterprise Application",
  "Optional System Connector",
  "BeaconGuard Runtime Control Boundary",
  "Determine ALLOW or DENY",
  "Persist Verifiable Decision Record",
];

const dependencies = [
  "Customer IdP / workforce identity",
  "Service / workload identity",
  "Shared replay authority",
  "Evidence provider",
  "Monitoring",
];

const capabilityPaths = ["Windows", "Linux", "OCI-oriented deployment"];
---

<DiagramShell
  title="Deployment and trust topology"
  caption="Management plane is outside the request path. Runtime evaluates, persists evidence, then forks to ALLOW (governed execution) or DENY (hard stop). Supporting dependencies are not alternate execution paths."
  className="bg-diagram--deployment"
>
  <div class="bg-planes bg-planes--responsive">
    <section class="bg-plane" aria-labelledby="deploy-mgmt-title">
      <h4 id="deploy-mgmt-title" class="bg-plane-title">
        A) Management plane
        <span class="bg-plane-badge">Outside request path</span>
      </h4>
      <div class="bg-flow" role="list">
        {
          management.map((step, index) => (
            <>
              <div
                class:list={[
                  "bg-flow-step",
                  step === "Active Verified Release" && "bg-outcome-evidence",
                ]}
                role="listitem"
              >
                {step}
              </div>
              {index < management.length - 1 && (
                <div class="bg-flow-arrow" aria-hidden="true">
                  ↓
                </div>
              )}
            </>
          ))
        }
      </div>
      <p class="bg-flow-note">
        Active Verified Release feeds the runtime control boundary.
      </p>
    </section>

    <section class="bg-plane" aria-labelledby="deploy-runtime-title">
      <h4 id="deploy-runtime-title" class="bg-plane-title">B) Runtime path</h4>
      <div class="bg-flow" role="list">
        {
          runtime.map((step, index) => (
            <>
              <div
                class:list={[
                  "bg-flow-step",
                  step.includes("Runtime Control") && "bg-flow-step--boundary",
                  step.includes("ALLOW or DENY") && "bg-flow-step--decision",
                  step.includes("Persist") && "bg-outcome-evidence",
                  step.includes("System Connector") && "bg-flow-step--optional",
                ]}
                role="listitem"
              >
                {step}
              </div>
              {index < runtime.length - 1 && (
                <div class="bg-flow-arrow" aria-hidden="true">
                  ↓
                </div>
              )}
            </>
          ))
        }
      </div>
      <OutcomeFork
        allowLabel="Governed AI / API / Automated System"
        denyLabel="Hard Stop / No Downstream Execution"
      />
    </section>

    <section class="bg-plane" aria-labelledby="deploy-deps-title">
      <h4 id="deploy-deps-title" class="bg-plane-title">
        C) Supporting dependencies
        <span class="bg-plane-badge">Side list — not an alternate path</span>
      </h4>
      <ul class="bg-dep-list">
        {dependencies.map((item) => <li>{item}</li>)}
      </ul>
      <p class="bg-flow-note">
        Capability-level operating paths (no public download claims):{" "}
        {capabilityPaths.join(" · ")}
      </p>
    </section>
  </div>

  <div slot="text">
    <p>
      Runtime path: Enterprise Application → Optional System Connector → Runtime
      Control Boundary → Determine ALLOW or DENY → Persist Verifiable Decision
      Record → fork ALLOW (governed system) or DENY (hard stop). Management
      plane remains outside the request path.
    </p>
  </div>
</DiagramShell>
