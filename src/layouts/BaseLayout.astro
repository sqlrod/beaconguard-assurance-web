---
const {
  title = "BeaconGuard Assurance",
  description = "BeaconGuard independently authorizes consequential AI actions before execution and preserves verifiable decision evidence tied to governed policy authority.",
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  ogType = "website",
  publishedTime,
  jsonLd,
} = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = "https://www.beaconguardassurance.com";
const canonicalUrl = canonical ?? new URL(currentPath, siteUrl).toString();
const absoluteOgImage = ogImage ? new URL(ogImage, siteUrl).toString() : undefined;
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a href="#content" class="skip-link">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="BeaconGuard Assurance home">
          <img
            class="brand-logo"
            src="/beaconguard-master-logo.png"
            alt="BeaconGuard Assurance"
          />
        </a>

        <nav class="header-nav" aria-label="Primary navigation">
          <a href="/platform" aria-current={currentPath === "/platform" ? "page" : undefined}>Product</a>
          <a href="/healthcare" aria-current={currentPath === "/healthcare" ? "page" : undefined}>Healthcare</a>
          <a href="/fintech" aria-current={currentPath === "/fintech" ? "page" : undefined}>Financial</a>
          <a href="/trust-assurance" aria-current={currentPath === "/trust-assurance" ? "page" : undefined}>Assurance</a>
          <a href="/insights" aria-current={currentPath === "/insights" || currentPath.startsWith("/insights/") ? "page" : undefined}>Insights</a>
          <a href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>Contact</a>
        </nav>
      </div>
    </header>

    <main id="content" role="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-inner">
        <div class="footer-left">
          <div class="footer-brand-lockup">
            <div class="footer-brand-mark">
              <img class="footer-brand-icon" src="/beaconguard-master-icon.png" alt="" aria-hidden="true" />
              <strong>BeaconGuard Assurance</strong>
            </div>
          </div>
        </div>

        <div class="footer-center">
          <p class="footer-slogan-line">Authorize the action. Prove the decision.</p>
          <p class="footer-slogan-line">Independent authorization for consequential AI actions.</p>
        </div>

        <div class="footer-right">
          <a href="/design-partner-program">Request Evaluation</a><br />
          <a href="/docs">Technical Reference</a>
        </div>
      </div>
    </footer>
  </body>
</html>
